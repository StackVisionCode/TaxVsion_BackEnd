<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!--
    Piezas de prueba que heredan los proyectos de pruebas de los servicios (BB-6). Es una biblioteca,
    no un proyecto de pruebas: no tiene Test.Sdk ni runner, para que referenciarla no arrastre nada.
  -->
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageReference Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
    <!-- BB-10: base temporal de las T-INT. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- SqlClient arrastra Pkcs 9.0.4 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): misma versión fija que BuildingBlocks.Web. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- BB-1/BB-2: reglas de eventos de dominio (IDomainEvent) y de colas locales (runtime de Wolverine). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.csproj" />
  </ItemGroup>
</Project>
