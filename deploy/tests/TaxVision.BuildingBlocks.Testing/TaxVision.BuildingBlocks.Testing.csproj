<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!--
    Piezas de prueba que heredan los proyectos de pruebas de los servicios (BB-6). Es una biblioteca,
    no un proyecto de pruebas: no tiene Test.Sdk ni runner, para que referenciarla no arrastre nada.
  -->
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

  <!-- BB-1/BB-2: reglas de eventos de dominio (IDomainEvent) y de colas locales (runtime de Wolverine). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.csproj" />
  </ItemGroup>
</Project>
