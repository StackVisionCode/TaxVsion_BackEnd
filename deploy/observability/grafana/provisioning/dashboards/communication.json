{
  "title": "TaxVision — Communication (meetings, llamadas y SFU)",
  "uid": "taxvision-communication",
  "tags": [
    "taxvision",
    "communication"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "F10 (ADD-08 T-74). Uso técnico en vivo. Las métricas de negocio por oficina/plan están en GET /communication/admin/analytics/* (PlatformAdmin).",
  "panels": [
    {
      "id": 1,
      "title": "Sockets activos (todos los procesos)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(communication_socket_connections_active{job=\"communication\"})",
          "legendFormat": "sockets",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Salas del SFU",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(communication_sfu_rooms_active{job=\"communication\"})",
          "legendFormat": "salas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Participantes en el SFU",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(communication_sfu_participants_active{job=\"communication\"})",
          "legendFormat": "participantes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Workers del SFU sin WebRtcServer (respaldo)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(communication_sfu_webrtcserver_fallback_workers{job=\"communication\"})",
          "legendFormat": "workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Fallos de transporte ICE/DTLS (por minuto)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (direction, layer) (rate(communication_sfu_transport_failures_total{job=\"communication\"}[5m])) * 60",
          "legendFormat": "{{direction}} {{layer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Transports conectados por protocolo (por minuto)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(communication_sfu_transports_connected_total{job=\"communication\"}[5m])) * 60",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Latencia HTTP p95 por ruta",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(communication_http_request_duration_seconds_bucket{job=\"communication\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Proyecciones de analítica fallidas (por hora)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (event_type) (increase(communication_consumer_projection_failures_total{job=\"communication\"}[1h]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Memoria residente del proceso Node",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"communication\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "CPU de los contenedores de Communication (cadvisor)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"taxvision-communication.*\"}[5m]))",
          "legendFormat": "CPU {{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Memoria de los contenedores de Communication (cadvisor)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"taxvision-communication.*\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
