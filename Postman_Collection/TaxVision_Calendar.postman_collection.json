{
  "info": {
    "name": "TaxVision - Calendar",
    "description": "Citas, series recurrentes, disponibilidad, conflictos y el feed .ics. Una serie NO se guarda en UTC: hora local + zona + RRULE. Ver README 51 y ADR-023.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Citas",
      "item": [
        {
          "name": "Crear cita puntual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{UrlBase}}/calendar/appointments",
              "host": [
                "{{UrlBase}}"
              ],
              "path": [
                "calendar",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Revision de la 1040\",\n  \"description\": null,\n  \"location\": \"Oficina 2\",\n  \"appointmentTypeId\": \"{{appointmentTypeId}}\",\n  \"timeZoneId\": \"America/New_York\",\n  \"startUtc\": \"2026-09-15T14:00:00Z\",\n  \"endUtc\": \"2026-09-15T15:00:00Z\",\n  \"customerId\": \"{{customerId}}\",\n  \"taxYear\": 2025,\n  \"isVirtual\": false\n}"
            }
          }
        },
        {
          "name": "Crear serie recurrente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{UrlBase}}/calendar/appointments",
              "host": [
                "{{UrlBase}}"
              ],
              "path": [
                "calendar",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Revision semanal\",\n  \"appointmentTypeId\": \"{{appointmentTypeId}}\",\n  \"timeZoneId\": \"America/New_York\",\n  \"seriesStartDate\": \"2026-09-07\",\n  \"localStartTime\": \"09:00:00\",\n  \"duration\": \"01:00:00\",\n  \"recurrenceRule\": \"FREQ=WEEKLY;BYDAY=MO\",\n  \"isVirtual\": true\n}"
            },
            "description": "Una serie NO lleva startUtc: se guarda como hora local + zona + RRULE. Guardarla en UTC la corre una hora al cambiar el horario de verano."
          }
        },
        {
          "name": "Ver una cita",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{UrlBase}}/calendar/appointments/{{appointmentId}}",
              "host": [
                "{{UrlBase}}"
              ],
              "path": [
                "calendar",
                "appointments",
                "{{appointmentId}}"
              ]
            }
          }
        },
        {
          "name": "Rango de fechas (expande las series)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{UrlBase}}/calendar/appointments?from=2026-09-01T00:00:00Z&to=2026-12-01T00:00:00Z",
              "host": [
                "{{UrlBase}}"
              ],
              "path": [
                "calendar",
                "appointments"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-09-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-12-01T00:00:00Z"
                }
              ]
            }
          }
        },
        {
          "name": "Mi dia",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{UrlBase}}/calendar/appointments/my-day?date=2027-05-10&timeZoneId=America/New_York",
              "host": [
                "{{UrlBase}}"
              ],
              "path": [
                "calendar",
                "appointments",
                "my-day"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2027-05-10"
                },
                {
                  "key": "timeZoneId",
                  "value": "America/New_York"
                }
              ]
            },
            "description": "Sin timeZoneId el dia es el de UTC, y una cita de las 20:30 en Nueva York aparece en la agenda del dia siguiente."
          }
        }
      ]
    },
    {
      "name": "Series y excepciones",
