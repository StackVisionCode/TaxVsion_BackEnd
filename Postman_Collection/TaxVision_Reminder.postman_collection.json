				},
				{
					"name": "Create con zona horaria invalida (400)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"url": {
							"raw": "{{UrlBase}}/reminders",
							"host": [ "{{UrlBase}}" ],
							"path": [ "reminders" ]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"zona inventada\",\n  \"category\": \"General\",\n  \"fireAtUtc\": \"2030-01-01T12:00:00Z\",\n  \"timeZone\": \"Mars/Olympus_Mons\",\n  \"requestKey\": \"negativo-tz\"\n}"
						},
						"description": "Validada con BuildingBlocks.TimeZones.IanaTimeZone.TryNormalize, que ya resuelve el mapeo IANA<->Windows. Aceptar cualquier string dejaria recordatorios que no se pueden renderizar en hora local."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [ "pm.test(\"status 400\", () => pm.response.code === 400);" ]
							}
						}
					]
				},
				{
					"name": "429 en upcoming (rate limit categoria H)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
						],
						"url": {
							"raw": "{{UrlBase}}/reminders/upcoming",
							"host": [ "{{UrlBase}}" ],
							"path": [ "reminders", "upcoming" ]
						},
						"description": "Correr con el Collection Runner ~120 iteraciones seguidas (cuota base 20/60s, escalada por tier con EnforceTierQuotas=true, overlay de tenant 100). OJO: las cabeceras X-RateLimit-* solo aparecen en la respuesta 429, NO en las 200 — buscarlas en un 200 y no encontrarlas no es un bug."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 429) {",
									"  pm.test(\"trae Retry-After\", () => pm.response.headers.has(\"Retry-After\"));",
									"  pm.test(\"trae X-RateLimit-Policy\", () => pm.response.headers.has(\"X-RateLimit-Policy\"));",
									"  pm.test(\"trae X-RateLimit-Remaining\", () => pm.response.headers.has(\"X-RateLimit-Remaining\"));",
									"} else {",
									"  pm.test(\"200 mientras no se agota la cuota\", () => pm.response.code === 200);",
									"}"
								]
							}
						}
					]
				}
			]
		}
	]
}
