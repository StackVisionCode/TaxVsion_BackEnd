{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-000000007a11",
    "name": "TaxVision — New Services (SMS, Catalog, Inventory, Billing)",
    "description": "Colección de los microservicios construidos/verificados: Auth (tokens), SMS, Catalog, Inventory y el wiring de Billing. Todo pasa por el Gateway ({{gateway}}). Ver postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Service token (M2M)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/service-token",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "service-token"
              ]
            },
            "description": "M2M token. clientSecret viene de .env (NOTIFICATION_SERVICE_CLIENT_SECRET). Guarda {{serviceToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{serviceClientId}}\",\n  \"clientSecret\": \"{{serviceClientSecret}}\",\n  \"tenantId\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = pm.response.json();",
                  "let t = j.accessToken || j.token || (j.tokens && j.tokens.accessToken);",
                  "if (t) { pm.collectionVariables.set('serviceToken', t); pm.test('token saved', () => pm.expect(t).to.be.ok); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (usuario, 2-step MFA opt-in)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login humano. Si MFA está activo, seguir con /auth/mfa/verify. Guarda {{userToken}} si viene directo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = pm.response.json();",
                  "let t = j.accessToken || (j.tokens && j.tokens.accessToken);",
                  "if (t) { pm.collectionVariables.set('userToken', t); }",
                  "pm.test('login ok (may need MFA/terms)', () => pm.expect(pm.response.code).to.be.oneOf([200,202]));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Tokens. Ejecutar 'Service token' primero para poblar {{serviceToken}}."
    },
