{
  "info": {
    "name": "TaxVision — Campaigns",
    "description": "Orquestador de campañas multicanal (SIN dinero). Flujo sugerido: Auth > Login (o pega un token con campaigns.manage en {{userToken}}) > Sender Profiles > Contacts > Contact Lists (import) > Campaigns (create, set sender, send) > Schedules. Todas las rutas pasan por el gateway :5047. Requiere permiso campaigns.manage y actor staff (TenantEmployee/TenantAdmin/PlatformAdmin).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth (token)",
      "description": "Corre 'Login' para poblar {{userToken}}. Campaigns exige campaigns.manage + actor staff; usa un usuario con ese permiso (o PlatformAdmin).",
      "item": [
        {
          "name": "Service token (M2M)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/service-token",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "service-token"
              ]
            },
            "description": "Token M2M (ActorType.Service). Guarda {{serviceToken}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{serviceClientId}}\",\n  \"clientSecret\": \"{{serviceClientSecret}}\",\n  \"tenantId\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = pm.response.json();",
                  "if (j && (j.accessToken || j.token || (j.tokens && j.tokens.accessToken)) != null) pm.collectionVariables.set('serviceToken', j.accessToken || j.token || (j.tokens && j.tokens.accessToken));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login humano. Si hay MFA, seguir con /auth/mfa/verify. Guarda {{userToken}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = pm.response.json();",
                  "if (j && (j.accessToken || (j.tokens && j.tokens.accessToken)) != null) pm.collectionVariables.set('userToken', j.accessToken || (j.tokens && j.tokens.accessToken));"
                ]
              }
            }
          ]
        }
      ]
    },
