<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    BB-3: unidad transaccional para jobs. Ensamblado propio porque usa EF Core y el outbox de Wolverine:
    dentro de BuildingBlocks.Infrastructure arrastraría EF Core también al Gateway. Opcional: solo lo
    referencia el servicio que lo adopta.
  -->
  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.14.0" />
  </ItemGroup>
</Project>
