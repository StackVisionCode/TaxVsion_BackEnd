<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Normalizador de imágenes (avatares). Ensamblado propio para que SkiaSharp y sus binarios nativos
    solo lleguen a los servicios que lo referencian (Auth, Customer), no a todo BuildingBlocks.
  -->
  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <!-- Misma versión que Signature (Apache/MIT, sin los CVE de ImageSharp 3.1.x). -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <!-- Linux sin fontconfig: aquí no se dibuja texto, así la imagen aspnet no necesita apt-get extra. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
  </ItemGroup>
</Project>
