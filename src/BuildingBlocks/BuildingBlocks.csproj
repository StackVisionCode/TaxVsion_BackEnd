<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BuildingBlocks.Infrastructure\**\*.cs" />
    <Compile Remove="BuildingBlocks.Web\**\*.cs" />
    <!--
      Los contratos de integración son su propio ensamblado (BuildingBlocks.Messaging). Son el
      folder más volátil del repo y ningún proyecto Domain los consume: dejarlos acá obligaba a
      recompilar los 18 Domain cada vez que cambiaba un evento.
    -->
    <Compile Remove="Messaging\**\*.cs" />
    <!--
      Los catálogos de permisos son su propio ensamblado (BuildingBlocks.Authorization): segundo
      folder más volátil y consumido casi solo por la capa Api.
    -->
    <Compile Remove="Authorization\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      [SagaIdentity] en AggregateRoot y los eventos de onboarding. Se queda aunque Messaging
      salga del ensamblado, porque Domain/AggregateRoot.cs también lo usa.
    -->
    <PackageReference Include="WolverineFx" Version="6.14.0" />
  </ItemGroup>
</Project>
