{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "ConnectionStrings": { "Default": "", "Redis": "localhost:6379" },
  "RabbitMq": { "Uri": "" },
  "RateLimit": { "EnforceTierQuotas": true },
  "FinancialProcessing": {
    "Enabled": true,
    "PollSeconds": 10,
    "MaxPages": 40,
    "MaxVisionPages": 3,
    "MaxTextCharacters": 160000,
    "MaxDocumentsPerTenantMonth": 10,
    "AllowedDownloadHosts": ["localhost", "127.0.0.1"]
  },
  "OpenAI": { "Model": "gpt-5.4-mini", "MaxOutputTokens": 16000, "ReasoningEffort": "low", "ChunkPages": 4, "ChunkCharacters": 12000 },
  "SubscriptionClient": { "BaseUrl": "http://localhost:5360" },
  "Authorization": {
    "PermissionsSource": "Projection",
    "ModuleGate": { "Enforce": true, "EnforcedModules": ["financial_insights"] }
  },
  "Services": {
    "Auth": { "BaseUrl": "" },
    "Customer": { "BaseUrl": "" },
    "CloudStorage": { "BaseUrl": "" },
    "Tenant": { "BaseUrl": "" }
  },
  "FinancialInsights": {
    "CustomerVisibility": { "Enabled": true },
    "CustomerReconciliation": { "Enabled": true, "IntervalHours": 12, "PageSize": 200, "NamesIntervalHours": 6 },
    "TenantReconciliation": { "Enabled": true, "IntervalHours": 12, "PageSize": 200 }
  },
  "OpenTelemetry": { "OtlpEndpoint": "http://localhost:4317" },
  "AllowedHosts": "*"
}
