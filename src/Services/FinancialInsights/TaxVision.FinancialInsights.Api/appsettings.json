{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "ConnectionStrings": { "Default": "", "Redis": "localhost:6379" },
  "RabbitMq": { "Uri": "" },
  "RateLimit": { "EnforceTierQuotas": true },
  "FinancialProcessing": {
    "Enabled": true,
    "PollSeconds": 10,
    "MaxPages": 10,
    "MaxVisionPages": 3,
    "MaxTextCharacters": 30000,
    "MaxDocumentsPerTenantMonth": 10,
    "AllowedDownloadHosts": ["localhost", "127.0.0.1"]
  },
  "OpenAI": { "Model": "gpt-5.4-mini", "MaxOutputTokens": 4000 },
  "SubscriptionClient": { "BaseUrl": "http://localhost:5360" },
  "Authorization": {
    "PermissionsSource": "Projection",
    "ModuleGate": { "Enforce": true, "EnforcedModules": ["financial_insights"] }
  },
  "Services": {
    "Auth": { "BaseUrl": "" },
    "Customer": { "BaseUrl": "" },
    "CloudStorage": { "BaseUrl": "" }
  },
  "AllowedHosts": "*"
}
