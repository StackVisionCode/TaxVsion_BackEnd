<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\CustomerVisibility\BuildingBlocks.CustomerVisibility.csproj" />
    <ProjectReference Include="..\TaxVision.Signature.Application\TaxVision.Signature.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Messaging\BuildingBlocks.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="PdfSharp" Version="6.2.0" />
    <!-- Aplanar firmas PNG transparentes sobre blanco antes de estampar: PdfSharp pinta el alfa como
         negro. Pura-managed (apta contenedor Linux), igual criterio cross-platform que el resto. -->
    <!-- ImageSharp 4.x cambió a licencia comercial (Six Labors Split License). Nos quedamos en 3.1.x
         (Apache 2.0) y usamos el patch más alto (3.1.12) que trae los últimos fixes de seguridad del
         decoder: TIFF overflow, WEBP metadata, Issue 2679. Subir a 4.x requiere comprar licencia. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- Override directo para parchear CVE GHSA-846f-f764-76mx (high) y GHSA-2fmv-rv2c-59x7 (moderate)
         del System.Security.Cryptography.Pkcs 9.0.4/10.0.0 que arrastran los paquetes de Microsoft. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo de plataforma embebido para el Certificate of Completion. -->
    <EmbeddedResource Include="Sealing\Assets\platform-logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
