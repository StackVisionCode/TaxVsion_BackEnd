<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\CustomerVisibility\BuildingBlocks.CustomerVisibility.csproj" />
    <ProjectReference Include="..\TaxVision.Signature.Application\TaxVision.Signature.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Messaging\BuildingBlocks.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="PdfSharp" Version="6.2.0" />
    <!-- Aplanar firmas PNG transparentes sobre blanco antes de estampar: PdfSharp pinta el alfa como
         negro. Pura-managed (apta contenedor Linux), igual criterio cross-platform que el resto. -->
    <!-- SkiaSharp (Apache 2.0, mantenido por Microsoft/Google) reemplaza SixLabors.ImageSharp 3.1.x
         (EOL con 5 CVEs sin patch gratuito: GHSA-gwg2-r3hj-4w44 moderate, GHSA-j3p4-wp97-rph4 high,
         GHSA-j9gm-c75j-xc9q high, GHSA-jjfr-hcj7-qf5w high, GHSA-wmxv-xphr-5c9g moderate). El uso
         vive solo en PdfSharpSealingEngine.FlattenOntoWhite — aplanar PNG con alfa sobre blanco. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <!-- NativeAssets por runtime: los binarios Linux cargan en los contenedores del deploy, y Windows
         los usan tests/dev local. Ambos se incluyen porque el repo compila con dotnet publish
         multiplataforma; cada runtime copia solo los suyos. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- Override directo para parchear CVE GHSA-846f-f764-76mx (high) y GHSA-2fmv-rv2c-59x7 (moderate)
         del System.Security.Cryptography.Pkcs 9.0.4/10.0.0 que arrastran los paquetes de Microsoft. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo de plataforma embebido para el Certificate of Completion. -->
    <EmbeddedResource Include="Sealing\Assets\platform-logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
