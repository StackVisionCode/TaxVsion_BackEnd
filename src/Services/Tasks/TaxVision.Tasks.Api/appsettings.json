{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "Encryption": {
    "MasterKey": "",
    "MasterKeyVersion": 1
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "ServiceAuthClient": {
    "AuthBaseUrl": "http://localhost:5124",
    "ClientId": "",
    "ClientSecret": ""
  },
  "SubscriptionClient": {
    "BaseUrl": "http://localhost:5360"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Tasks": {
    "Customer": {
      "BaseUrl": "http://localhost:5263"
    },
    "CloudStorage": {
      "BaseUrl": "http://localhost:5330"
    },
    "ClientReminders": {
      "Enabled": false,
      "DaysBeforeDue": 3
    },
    "StaleAttachments": {
      "IntervalMinutes": 5,
      "GraceMinutes": 10,
      "BatchSize": 100
    },
    "OverdueSweep": {
      "IntervalMinutes": 60,
      "BatchSize": 200
    }
  },
  "ClientForms": {
    "Enabled": false,
    "Limits": {
      "MaxDefinitionBytes": 524288,
      "MaxPages": 50,
      "MaxSectionsPerPage": 20,
      "MaxComponentsPerSection": 60,
      "MaxComponents": 600,
      "MaxOptionsPerChoice": 200,
      "MaxLabelLength": 300,
      "MaxHelpTextLength": 2000,
      "MaxParagraphLength": 8000,
      "MaxConditionNodes": 50,
      "MaxConditionDepth": 5,
      "MaxRepeaterRows": 50,
      "MaxNestingDepth": 1,
      "MaxAnswersBytes": 1048576,
      "MaxFilesPerField": 20,
      "MaxFilesPerSubmission": 200,
      "MaxSubmissionTotalBytes": 262144000,
      "MaxFileBytes": 26214400
    },
    "Attachments": {
      "PendingExpiryMinutes": 60,
      "ReconciliationIntervalMinutes": 5,
      "ReconcileAfterMinutes": 10
    },
    "Reminders": {
      "Enabled": true,
      "DaysBeforeDue": [3, 1],
      "OverdueEveryDays": 3,
      "MaxReminders": 5,
      "JobIntervalMinutes": 60
    },
    "External": {
      "MaxIntakeSubmissionsPerTenantPerDay": 200,
      "MaxOtpIssuesPerTenantPerHour": 300,
      "BotProtection": {
        "SecretKey": "",
        "SiteVerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
        "ExpectedAction": "client_forms_intake"
      }
    }
  }
}
