{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "ServiceAuthClient": {
    "AuthBaseUrl": "http://localhost:5124",
    "ClientId": "",
    "ClientSecret": ""
  },
  "SubscriptionClient": {
    "BaseUrl": "http://localhost:5360"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Tasks": {
    "Customer": {
      "BaseUrl": "http://localhost:5263"
    },
    "CloudStorage": {
      "BaseUrl": "http://localhost:5330"
    },
    "ClientReminders": {
      "Enabled": false,
      "DaysBeforeDue": 3
    },
    "StaleAttachments": {
      "IntervalMinutes": 5,
      "GraceMinutes": 10,
      "BatchSize": 100
    },
    "OverdueSweep": {
      "IntervalMinutes": 60,
      "BatchSize": 200
    }
  }
}