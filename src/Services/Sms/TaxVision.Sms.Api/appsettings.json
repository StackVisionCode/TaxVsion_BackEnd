{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Sms": {
    "DefaultProvider": "fake",
    "__comment_ProviderOrder": "Cadena de failover (decisión de plataforma). Vacía = solo DefaultProvider. Ej: [\"infobip\",\"textmaxx\"] envía por Infobip y si rechaza/cae reintenta con Textmaxx. Se puede setear por env Sms__ProviderOrder__0, __1, ...",
    "ProviderOrder": [],
    "MaxBatchSize": 1000,
    "Providers": {
      "fake": {
        "Webhook": {
          "Secret": "fake-dev-secret"
        },
        "Capabilities": {
          "SupportsDeliveryReceipts": true,
          "SupportsInbound": true,
          "SupportsBulkSend": false,
          "MaxBatchSize": 1,
          "SupportsMedia": true,
          "SupportsMultipleMedia": true,
          "MaxMediaItems": 10,
          "MaxMediaSizeBytes": 5242880,
          "AllowedMediaTypes": []
        }
      },
      "generic": {
        "BaseUrl": "",
        "SendPath": "/",
        "HttpMethod": "POST",
        "BodyFormat": "json",
        "SenderId": "",
        "Auth": { "Type": "none" },
        "RequestMap": { "To": "to", "From": "from", "Body": "body", "Media": "media" },
        "ResponseMap": { "ProviderMessageIdPath": "id" },
        "Webhook": {
          "Secret": "",
          "SignatureHeader": "X-Signature",
          "HmacAlgo": "HMACSHA256",
          "ProviderMessageIdPath": "messageId",
          "StatusPath": "status",
          "EventTypePath": "eventType",
          "FromPath": "from",
          "KeywordPath": "text",
          "StatusMap": {}
        },
        "Capabilities": {
          "SupportsDeliveryReceipts": true,
          "SupportsInbound": true,
          "SupportsBulkSend": false,
          "MaxBatchSize": 1,
          "SupportsMedia": false,
          "SupportsMultipleMedia": false,
          "MaxMediaItems": 1,
          "MaxMediaSizeBytes": 0,
          "AllowedMediaTypes": []
        }
      },
      "textmaxx": {
        "BaseUrl": "",
        "SendPath": "/",
        "HttpMethod": "POST",
        "BodyFormat": "form",
        "SenderId": "",
        "__comment_Auth": "Basic base64(clientApiKey:userApiToken) — poner el par unido en Credential vía env/secret-manager, NUNCA hardcoded.",
        "Auth": { "Type": "basic", "Credential": "" },
        "RequestMap": { "To": "to", "From": "from", "Body": "message" },
        "ResponseMap": { "ProviderMessageIdPath": "id" },
        "__comment_Webhook": "Textmaxx legado no firma DLR; solo aplica si se pone un proxy firmante. Capabilities (solo texto, sin DLR) van fijas en TextmaxxSmsProvider.",
        "Webhook": {
          "Secret": "",
          "SignatureHeader": "X-Signature",
          "HmacAlgo": "HMACSHA256",
          "ProviderMessageIdPath": "messageId",
          "StatusPath": "status",
          "EventTypePath": "eventType",
          "FromPath": "from",
          "KeywordPath": "text",
          "StatusMap": {}
        }
      },
      "infobip": {
        "BaseUrl": "",
        "SendPath": "/sms/2/text/advanced",
        "SenderId": "InfoSMS",
        "__comment_Auth": "Auth Infobip = header 'Authorization: App {apiKey}'. La API key es SECRETA: se inyecta por env Sms__Providers__infobip__Auth__Credential (SMS_INFOBIP_API_KEY), NUNCA en el repo. BaseUrl (ej. https://vyg8je.api.infobip.com) también por env.",
        "Auth": { "Type": "app", "Credential": "" },
        "Webhook": {
          "Secret": ""
        }
      },
      "twilio": {
        "BaseUrl": "https://api.twilio.com",
        "SenderId": "",
        "__comment_Auth": "Twilio = Basic base64(AccountSid:AuthToken). Poné el par 'ACxxxx:authtoken' en Credential vía env Sms__Providers__twilio__Auth__Credential (SMS_TWILIO_CREDENTIAL). SenderId = número From (+1...) o Messaging Service Sid. La firma de webhook usa el AuthToken de esta credencial.",
        "Auth": { "Type": "basic", "Credential": "" }
      }
    }
  }
}
