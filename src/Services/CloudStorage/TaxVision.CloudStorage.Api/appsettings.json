{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "ResourceOwnership": {
      "Enabled": true
    },
    "PermissionsSource": "Projection"
  },
  "CloudStorage": {
    "PublicShareConflictRetry": {
      "MaxAttempts": 3
    },
    "AssignmentVisibility": {
      "Enabled": false
    },
    "PerItemAccess": {
      "Enabled": false
    },
    "MainBucket": "taxvision-storage",
    "TempBucket": "taxvision-temp",
    "QuarantineBucket": "taxvision-quarantine",
    "DefaultStorageQuotaBytes": 10737418240,
    "ScanParallelism": 2
  },
  "Minio": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "",
    "SecretKey": "",
    "UseTls": false
  },
  "ClamAv": {
    "Host": "localhost",
    "Port": 3310,
    "TimeoutSeconds": 120,
    "ChunkSizeBytes": 65536
  },
  "ContentScanner": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 120,
    "MaxAttempts": 3,
    "RetryDelayMilliseconds": 1000
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  }
}
