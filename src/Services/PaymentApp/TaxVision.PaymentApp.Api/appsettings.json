{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services",
    "ValidAudiences": [
      "TaxVision.Services",
      "TaxVision.Account"
    ]
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ClientId": "",
    "ClientSecret": "",
    "WebhookId": "",
    "OfflineFallback": {
      "Enabled": false
    }
  },
  "Intellipay": {
    "MerchantKey": "",
    "ApiKey": ""
  },
  "PaymentMethods": {
    "Onboarding": []
  },
  "PaymentApp": {
    "ChargeExecution": {
      "ProviderKeyWindow": "23:00:00",
      "PendingChargeThreshold": "00:30:00",
      "ProviderClockSkew": "00:05:00"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHosts": "*"
}
