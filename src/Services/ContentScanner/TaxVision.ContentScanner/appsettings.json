{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContentScanner": {
    "ModelPath": "/models/nsfw.onnx",
    "InputSize": 384,
    "Mean": [ 0.5, 0.5, 0.5 ],
    "Std": [ 0.5, 0.5, 0.5 ],
    "NsfwLabelIndex": 1,
    "ApiKey": "",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "FfmpegTimeoutSeconds": 90,
    "MaxConcurrentScans": 2,
    "QueueTimeoutSeconds": 30,
    "InferenceThreads": 1,
    "MaxUploadBytes": 1073741824,
    "MinFrameIntervalSeconds": 1,
    "MaxFrames": 30,
    "TempDirectory": "/tmp/content-scanner"
  }
}
