{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection",
    "ResourceOwnership": {
      "Enabled": true
    }
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "ServiceAuthClient": {
    "AuthBaseUrl": "http://localhost:5124",
    "ClientId": "",
    "ClientSecret": ""
  },
  "SubscriptionClient": {
    "BaseUrl": "http://localhost:5360"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Wallet": {
    "Reservations": {
      "ExpiryEnabled": true,
      "OpenTtl": {
        "campaign-run": "3.00:00:00",
        "individual-sms": "01:00:00"
      },
      "DefaultOpenTtl": "3.00:00:00",
      "ExpiryInterval": "00:15:00",
      "ExpiryBatchSize": 200
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  }
}
