{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services",
    "ValidAudiences": [
      "TaxVision.Services",
      "TaxVision.Account"
    ]
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "Encryption": {
    "MasterKey": "",
    "MasterKeyVersion": 1
  },
  "BillingClient": {
    "BaseUrl": "http://localhost:5460"
  },
  "Tenant": {
    "WispReviewReminders": {
      "Enabled": true,
      "IntervalMinutes": 1440,
      "BatchSize": 100,
      "LockTtlMinutes": 30
    }
  },
  "AllowedHosts": "*"
}
