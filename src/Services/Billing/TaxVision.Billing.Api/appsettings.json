{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services",
    "ValidAudiences": [
      "TaxVision.Services",
      "taxvision-billing"
    ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "Billing": {
    "SyncReconciliation": {
      "Enabled": true,
      "Interval": "00:15:00",
      "Grace": "00:15:00",
      "BatchSize": 100,
      "NotBeforeUtc": "2026-11-04T23:31:09Z"
    }
  },
  "AllowedHosts": "*"
}
