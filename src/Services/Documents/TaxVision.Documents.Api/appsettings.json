{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services",
    "ValidAudiences": [
      "TaxVision.Services",
      "taxvision-documents"
    ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Documents": {
    "Pdf": {
      "MaxConcurrency": 2
    },
    "Minio": {
      "Endpoint": "localhost:9000",
      "AccessKey": "documents-worker",
      "SecretKey": "",
      "UseTls": false,
      "TempBucket": "taxvision-temp",
      "SourcePrefix": "documents"
    }
  },
  "AllowedHosts": "*"
}
