// TaxVision.Communication — Prisma schema
//
// Convenciones alineadas con el resto del backend:
//   - TenantId en TODAS las tablas de negocio; filtro global obligatorio en repos.
//   - PascalCase en tablas y columnas (misma convención que EF Core en otros servicios).
//   - datetime2 UTC via @db.DateTime2.
//   - Soft-delete via IsDeleted + DeletedAtUtc cuando aplique.
//   - Enums como string columns (@db.NVarChar(64)) para tolerar rename sin migrar datos.
//
// Fase 0 sólo materializa:
//   - TenantCommunicationSettings (comportamiento por tenant).
//   - TenantCommunicationLimits (proyección alimentada por Subscription events).
//   - UserPermissionsProjection (proyección alimentada por Auth UserRolesChanged).
//
// Los agregados (Conversation, Call, Meeting, etc.) llegan en fases posteriores.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("COMMUNICATION_DB_CONNECTION")
}

// -----------------------------------------------------------------------------
// TenantCommunicationSettings — comportamiento de Communication por tenant.
// -----------------------------------------------------------------------------
model TenantCommunicationSettings {
  TenantId                               String   @id @db.UniqueIdentifier
  // Canales habilitados por tenant admin.
  ChatEnabled                            Boolean  @default(true)
  CallsEnabled                           Boolean  @default(true)
  VideoCallsEnabled                      Boolean  @default(true)
  MeetingsEnabled                        Boolean  @default(true)
  SupportEnabled                         Boolean  @default(true)
  ScreenshotsEnabled                     Boolean  @default(true)
  InternalGroupsEnabled                  Boolean  @default(false)
  EmployeeToEmployeeChatEnabled          Boolean  @default(false)
  // Fase B5 (chat tipado) — si esta en true, un chat directo donde uno de los
  // dos lados es 'CustomerPortal' solo se permite si el otro lado es
  // justamente el preparador asignado de ese customer (CustomerPreparerAssignment).
  // Default false: mismo criterio que EmployeeToEmployeeChatEnabled, opt-in
  // explicito del tenant admin, no rompe el comportamiento actual de nadie.
  RestrictCustomerChatToAssignedPreparer Boolean  @default(false)
  // F8b (D-20): varios clientes en un mismo grupo (se ven entre sí). Default: uno solo.
  GroupsAllowMultipleClients             Boolean  @default(false)
  // Meeting UX defaults (cierran fricción detectada en el frontend cliente).
  DefaultCameraOff                       Boolean  @default(true)
  DefaultMicrophoneOff                   Boolean  @default(false)
  PersistChatOnEnd                       Boolean  @default(false)
  // Retención y purge (feature-flag OFF por default).
  // Politica de consentimiento de grabacion (Fase Backend 2) — ver
  // RecordingConsentPolicy en domain/recording/recording-consent.ts.
  // "AllAcceptedRequired" | "NoRejections" | "HostOverride"
  RecordingConsentPolicy                 String   @default("NoRejections") @db.NVarChar(32)
  // Ajustes de oficina dentro del techo efectivo (null = hereda el valor de la plataforma/plan).
  // El dominio valida que nunca superen el techo (TenantCommunicationConstraints + plan + global).
  DefaultMeetingDurationMinutes          Int?
  MaxMeetingDurationMinutes              Int?
  MaxMeetingParticipants                 Int?
  MaxRecordingMinutesMeeting             Int?
  MaxRecordingMinutesAudioCall           Int?
  MaxRecordingMinutesVideoCall           Int?
  RingingTimeoutSeconds                  Int?
  MeetingChatAttachmentsPerMinute        Int?
  MeetingChatAttachmentsPerMeeting       Int?
  // "all" | "hostOnly" | "off"; null = política global.
  MeetingSoundsPolicy                    String?  @db.NVarChar(16)
  // Código BCP-47 corto o "auto"; null = idioma global.
  TranscriptLanguage                     String?  @db.NVarChar(16)
  RecordingVisibleInPortal               Boolean  @default(true)
  GuestsAllowed                          Boolean  @default(true)
  // F4 (null = hereda la plataforma): pantalla D-42, procesamiento de audio D-46, eco D-52.
  ClientsCanShareScreen                  Boolean?
  ScreenAudioAllowed                     Boolean?
  AudioEchoCancellationDefault           Boolean?
  AudioNoiseSuppressionDefault           Boolean?
  AudioAutoGainControlDefault            Boolean?
  EchoMuteOnDetect                       Boolean?
  // F5 (D-50; null = hereda): reacciones apagadas por la oficina o catalogo acotado (JSON array).
  ReactionsEnabled                       Boolean?
  MeetingReactionCatalog                 String?  @db.NVarChar(1024)
  // F6 (null = hereda): recordatorio T-N y sala de espera para guests.
  MeetingReminderMinutesBefore           Int?
  GuestsWaitingRoom                      Boolean?
  // F7 (null = hereda): vocabulario del transcript (T-30) y notas de voz transcritas (D-27).
  TranscriptPrompt                       String?  @db.NVarChar(500)
  VoiceNoteTranscriptEnabled             Boolean?
  // F8: ventana de edición de la oficina (minutos por tipo de chat; NULL = hereda la plataforma, nunca la supera).
  ChatEditWindowMinutesDirect            Int?
  ChatEditWindowMinutesGroup             Int?
  ChatEditWindowMinutesSupport           Int?
  ChatEditWindowMinutesMeeting           Int?
  ChatMaxEditsPerMessage                 Int?
  // Auditoría.
  CreatedAtUtc                           DateTime @default(now()) @db.DateTime2
  UpdatedAtUtc                           DateTime @default(now()) @updatedAt @db.DateTime2
}

// -----------------------------------------------------------------------------
// TenantCommunicationLimits — proyección desde Subscription events.
// Las columnas de plan son nullable: null = el plan no define la clave y rige el
// valor global de PlatformCommunicationSettings (los defaults salen del código).
// -----------------------------------------------------------------------------
model TenantCommunicationLimits {
  TenantId                     String   @id @db.UniqueIdentifier
  PlanCode                     String   @db.NVarChar(64)
  MaxMeetingParticipants       Int?
  MaxMeetingMinutes            Int?
  MaxConcurrentCalls           Int?
  MaxMonthlyMinutes            Int?
  RecordingEnabled             Boolean?
  SupportEnabled               Boolean  @default(true)
  IsSuspended                  Boolean  @default(false)
  EnabledModulesJson           String   @default("[]") @db.NVarChar(Max)
  // Claves communication.* nuevas del catálogo (null = no definidas por el plan).
  MaxRecordingMinutesMeeting   Int?
  MaxRecordingMinutesAudioCall Int?
  MaxRecordingMinutesVideoCall Int?
  RecordingVideoEnabled        Boolean?
  TranscriptEnabled            Boolean?
  CallsEnabled                 Boolean?
  MaxCallMinutes               Int?
  UpdatedAtUtc                 DateTime @default(now()) @updatedAt @db.DateTime2
}

// -----------------------------------------------------------------------------
// PlatformCommunicationSettings — fila única ("global") que administra PlatformAdmin.
// Techos técnicos en domain/settings/technical-limits.ts; aquí solo valores vigentes.
// -----------------------------------------------------------------------------
model PlatformCommunicationSettings {
  Id                                    String   @id @default("global") @db.NVarChar(16)
  // Sube en cada cambio: las cachés por oficina lo comparan para recomputar.
  Version                               Int      @default(1)
  // Meetings (D-34/D-35, COMP-02, INV-02).
  MaxMeetingDurationMinutes             Int      @default(60)
  DefaultMeetingDurationMinutes         Int      @default(60)
  DefaultMaxParticipants                Int      @default(10)
  MeshMaxParticipants                   Int      @default(2)
  DisconnectGraceSeconds                Int      @default(30)
  ScheduledMeetingExpiryHours           Int      @default(24)
  EmptyMeetingEndMinutes                Int      @default(10)
  DominantSpeakerMaxPerSecond           Int      @default(5)
  GuestsAllowed                         Boolean  @default(true)
  // Llamadas.
  RingingTimeoutSeconds                 Int      @default(60)
  // Grabación (D-32 acotado por C-04) y consentimiento.
  RecordingConsentTimeoutMeetingSeconds Int      @default(30)
  RecordingConsentTimeoutCallSeconds    Int      @default(15)
  MaxRecordingMinutesMeeting            Int      @default(60)
  MaxRecordingMinutesAudioCall          Int      @default(60)
  MaxRecordingMinutesVideoCall          Int      @default(60)
  // Invitaciones (D-48): vence al fin de la reunión + gracia, nunca antes del mínimo.
  InvitationMinTtlHours                 Int      @default(168)
  InvitationExpiryGraceHours            Int      @default(24)
  // Chat y grupos (D-16, D-15, D-24).
  InternalGroupsEnabled                 Boolean  @default(true)
  MeetingChatAttachmentsPerMinute       Int      @default(5)
  MeetingChatAttachmentsPerMeeting      Int      @default(20)
  MaxReactionsPerMessage                Int      @default(3)
  // F8: techo de la ventana de edición por tipo de chat (0 = no se edita) y tope de ediciones por mensaje.
  ChatEditWindowMinutesDirect           Int      @default(15)
  ChatEditWindowMinutesGroup            Int      @default(15)
  ChatEditWindowMinutesSupport          Int      @default(5)
  ChatEditWindowMinutesMeeting          Int      @default(15)
  ChatMaxEditsPerMessage                Int      @default(5)
  // Sonidos (D-02) y transcript (D-26).
  MeetingSoundsPolicy                   String   @default("all") @db.NVarChar(16)
  TranscriptDefaultLanguage             String   @default("auto") @db.NVarChar(16)
  // Retención operativa (ADD-08 T-73).
  OutboxRetentionDays                   Int      @default(7)
  ProcessedEventRetentionDays           Int      @default(14)
  IdempotencyRetentionDays              Int      @default(30)
  // F4: politica de media.
  QualitySampleIntervalSeconds          Int      @default(3)
  QualityExcellentRttMs                 Int      @default(150)
  QualityGoodRttMs                      Int      @default(300)
  QualityUnstableRttMs                  Int      @default(500)
  QualityExcellentLossPct               Int      @default(2)
  QualityGoodLossPct                    Int      @default(5)
  QualityUnstableLossPct                Int      @default(10)
  QualityExcellentJitterMs              Int      @default(30)
  QualityGoodJitterMs                   Int      @default(50)
  QualityUnstableJitterMs               Int      @default(100)
  QualityUpgradeSamples                 Int      @default(2)
  QualityPoorSustainedSamples           Int      @default(3)
  QualityRecoverySamples                Int      @default(3)
  CameraMaxWidth                        Int      @default(1280)
  CameraMaxHeight                       Int      @default(720)
  CameraMaxFps                          Int      @default(30)
  MeshCameraMaxWidth                    Int      @default(640)
  MeshCameraMaxHeight                   Int      @default(360)
  MeshCameraMaxFps                      Int      @default(24)
  ScreenMaxWidth                        Int      @default(1920)
  ScreenMaxHeight                       Int      @default(1080)
  ScreenMaxFps                          Int      @default(15)
  ScreenVideoMaxFps                     Int      @default(30)
  ScreenBitrateKbps                     Int      @default(1500)
  ScreenHighBitrateKbps                 Int      @default(3000)
  AudioMaxAverageBitrateKbps            Int      @default(40)
  MuteReleasesHardwareMinutes           Int      @default(5)
  SoundsVolumePct                       Int      @default(60)
  SoundsRepeatGapMs                     Int      @default(400)
  SfuMaxIncomingBitrateKbps             Int      @default(2500)
  SfuStatsSampleSeconds                 Int      @default(10)
  CameraMaxBitrateKbps                  Int      @default(1250)
  ClientRecordingAudioKbps              Int      @default(56)
  OpusFecEnabled                        Boolean  @default(true)
  OpusDtxEnabled                        Boolean  @default(true)
  AudioEchoCancellationDefault          Boolean  @default(true)
  AudioNoiseSuppressionDefault          Boolean  @default(true)
  AudioAutoGainControlDefault           Boolean  @default(true)
  ClientsCanShareScreen                 Boolean  @default(true)
  ScreenAudioAllowed                    Boolean  @default(true)
  EchoDetectionEnabled                  Boolean  @default(true)
  EchoMuteOnDetect                      Boolean  @default(false)
  // F5 (D-50): reacciones efimeras del meeting; el catalogo es un JSON array de emojis.
  ReactionsEnabled                      Boolean  @default(true)
  ReactionDurationSeconds               Int      @default(4)
  ReactionsPerUserPer10s                Int      @default(5)
  ReactionsPerMeetingPerMinute          Int      @default(300)
  MeetingReactionCatalog                String   @default("[\"👍\",\"👏\",\"❤️\",\"😂\",\"😮\",\"🎉\",\"🙏\",\"🤔\",\"✅\",\"🔥\"]") @db.NVarChar(1024)
  // F6 (T-64, D-47): recordatorio T-N (0 = apagado) y sala de espera por defecto para guests.
  MeetingReminderMinutesBefore          Int      @default(15)
  GuestsWaitingRoomDefault              Boolean  @default(true)
  // F7: grabación server-side (0 = mezcla en el cliente, C-03), límites, composición, retención y notas de voz.
  ServerSideRecordingEnabled            Boolean  @default(true)
  RecordingLimitWarningMinutes          Int      @default(5)
  RecordingLimitToleranceSeconds        Int      @default(120)
  RecordingCompositionWidth             Int      @default(1280)
  RecordingCompositionHeight            Int      @default(720)
  RecordingCompositionFps               Int      @default(25)
  RecordingCompositionVideoKbps         Int      @default(1500)
  RecordingCompositionAudioKbps         Int      @default(128)
  RecordingCompositionFormat            String   @default("mp4") @db.NVarChar(8)
  RecordingCaptureSpatialLayer          Int      @default(2)
  RecordingTracksRetentionDays          Int      @default(7)
  VoiceNoteTranscriptEnabled            Boolean  @default(true)
  VoiceNoteTranscriptMaxSeconds         Int      @default(600)
  TranscriptWorkerTimeoutFactorPct      Int      @default(150)
  RecordingAvailabilityTimeoutMinutes   Int      @default(60)
  // F10 (ADD-08): zona con la que se cortan los días de analítica y retenciones (null = no se purga).
  AnalyticsTimeZone                     String   @default("UTC") @db.NVarChar(64)
  AnalyticsRetentionDays                Int      @default(730)
  // Retención de mensajes y grabaciones y purga automática: la decide la plataforma, no la oficina.
  MessageRetentionDays                  Int      @default(365)
  RecordingRetentionDays                Int      @default(90)
  PurgeEnabled                          Boolean  @default(false)
  CallsRetentionDays                    Int?
  MeetingsRetentionDays                 Int?
  InvitationsRetentionDays              Int?
  UpdatedByUserId                       String?  @db.UniqueIdentifier
  UpdatedAtUtc                          DateTime @default(now()) @updatedAt @db.DateTime2
}

// -----------------------------------------------------------------------------
// TenantCommunicationConstraints — techos por oficina (PlatformAdmin, patrón Signature).
// null = sin techo propio; rige el del plan/global.
// -----------------------------------------------------------------------------
model TenantCommunicationConstraints {
  TenantId                     String   @id @db.UniqueIdentifier
  Version                      Int      @default(1)
  MaxMeetingParticipants       Int?
  MaxMeetingDurationMinutes    Int?
  MaxRecordingMinutesMeeting   Int?
  MaxRecordingMinutesAudioCall Int?
  MaxRecordingMinutesVideoCall Int?
  RecordingAllowed             Boolean?
  GuestsAllowed                Boolean?
  // Excepción de retención de esta oficina (null = la global de la plataforma). Solo PlatformAdmin.
  MessageRetentionDays         Int?
  RecordingRetentionDays       Int?
  PurgeEnabled                 Boolean?
  Notes                        String?  @db.NVarChar(512)
  UpdatedByUserId              String?  @db.UniqueIdentifier
  CreatedAtUtc                 DateTime @default(now()) @db.DateTime2
  UpdatedAtUtc                 DateTime @default(now()) @updatedAt @db.DateTime2
}

// -----------------------------------------------------------------------------
// UserCommunicationPreferences — autoservicio por usuario (D-02, INV-03 §13.6).
// -----------------------------------------------------------------------------
model UserCommunicationPreferences {
  TenantId             String   @db.UniqueIdentifier
  UserId               String   @db.UniqueIdentifier
  MeetingSoundsMuted   Boolean  @default(false)
  TranscriptLanguage   String?  @db.NVarChar(16)
  PreferAudioOnly      Boolean  @default(false)
  // F4 (D-46): procesamiento de audio (null = default de la oficina) y como entrar.
  EchoCancellation     Boolean?
  NoiseSuppression     Boolean?
  AutoGainControl      Boolean?
  JoinMuted            Boolean  @default(false)
  JoinCameraOff        Boolean  @default(false)
  // F9: ventana flotante automática al ocultar la pestaña (antes solo en localStorage).
  AutoPictureInPicture Boolean  @default(false)
  UpdatedAtUtc         DateTime @default(now()) @updatedAt @db.DateTime2

  @@id([TenantId, UserId])
}

// -----------------------------------------------------------------------------
// ConfigurationAudit — una fila por clave cambiada en cualquier capa de configuración.
// TenantId null = cambio global de plataforma.
// -----------------------------------------------------------------------------
model ConfigurationAudit {
  Id            String   @id @default(uuid()) @db.UniqueIdentifier
  TenantId      String?  @db.UniqueIdentifier
  // "Platform" | "TenantConstraints" | "TenantSettings" | "UserPreferences"
  Scope         String   @db.NVarChar(32)
  Key           String   @db.NVarChar(128)
  OldValue      String?  @db.NVarChar(512)
  NewValue      String?  @db.NVarChar(512)
  ActorUserId   String?  @db.UniqueIdentifier
  // "Update" | "AutoCorrect"
  Reason        String   @db.NVarChar(32)
  CorrelationId String?  @db.NVarChar(128)
  CreatedAtUtc  DateTime @default(now()) @db.DateTime2

  @@index([TenantId, CreatedAtUtc])
  @@index([Scope, CreatedAtUtc])
}

// -----------------------------------------------------------------------------
// UserPermissionsProjection — copia local de (UserId → perm[] + perm_v).
// Alimentada por consumers de Auth.UserRolesChanged/UserRegistered/UserDeactivated.
// Se usa para autorizar acciones socket sin round-trip a Auth por evento.
// -----------------------------------------------------------------------------
model UserPermissionsProjection {
  UserId       String   @id @db.UniqueIdentifier
  TenantId     String   @db.UniqueIdentifier
  Permissions  String   @db.NVarChar(Max) // JSON array de strings
  PermVersion  Int      @default(1)
  // Fase 2 del plan de notificaciones dinamicas — RoleIds del usuario (JSON array de strings),
  // para correlacionar "a este usuario le afecta este cambio" cuando llega
  // RolePermissionsChangedIntegrationEvent, sin volver a preguntarle a Auth. Filtrado con
  // `contains` sobre el string JSON entrecomillado (`"<roleId>"`) — un roleId nunca matchea
  // parcialmente a otro porque los GUID son de largo fijo.
  RoleIds      String   @default("[]") @db.NVarChar(Max)
  ActorType    String   @db.NVarChar(64)
  IsActive     Boolean  @default(true)
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId, IsActive])
}

// -----------------------------------------------------------------------------
// RolePermissionsProjection — copia local de (RoleId -> PermissionCodes[] + version).
// Alimentada por RolePermissionsChangedIntegrationEvent (Fase 2, plan de notificaciones
// dinamicas). Existe para que, cuando cambian los permisos de UN rol, se pueda recomputar
// correctamente la union de permisos de un usuario con VARIOS roles — sin esta cache,
// sobrescribir UserPermissionsProjection.Permissions con solo los codigos del rol que
// cambio perderia los permisos heredados de sus otros roles.
// -----------------------------------------------------------------------------
model RolePermissionsProjection {
  RoleId             String   @id @db.UniqueIdentifier
  TenantId           String   @db.UniqueIdentifier
  RoleName           String   @db.NVarChar(60)
  PermissionCodes    String   @db.NVarChar(Max) // JSON array de strings
  PermissionsVersion Int      @default(1)
  UpdatedAtUtc       DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId])
}

// -----------------------------------------------------------------------------
// UserDirectoryEntry — copia local de (UserId → DisplayName, Email).
// Alimentada por consumers de Auth.UserRegistered/UserProfileUpdated/UserDeactivated.
// Se usa para resolver el displayName real en payloads de chat/call/meeting sin
// depender de un round-trip HTTP a Auth por cada emit de socket. Mismo estilo que
// UserPermissionsProjection (arriba).
// -----------------------------------------------------------------------------
model UserDirectoryEntry {
  UserId       String   @id @db.UniqueIdentifier
  TenantId     String   @db.UniqueIdentifier
  DisplayName  String   @db.NVarChar(200)
  Email        String   @db.NVarChar(320)
  IsActive     Boolean  @default(true)
  // Fase Backend 10 — permite filtrar lookups a solo empleados de tenant
  // ("TenantEmployee") sin necesitar una proyeccion EmployeeDirectory
  // separada; ver docblock de CustomerDirectoryEntry para el contraste con
  // customers (proyeccion propia, source distinto).
  ActorType    String   @default("TenantEmployee") @db.NVarChar(32)
  // Foto vigente del staff (Auth User.AvatarFileId; se sirve en /storage/avatars/{id}). Null = sin foto.
  // Los portal users la leen de CustomerDirectoryEntry via CustomerPortalAccount.
  AvatarFileId String?  @db.UniqueIdentifier
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId, IsActive])
  // F8c (T-14): rail Team paginado por nombre.
  @@index([TenantId, IsActive, DisplayName])
}

// -----------------------------------------------------------------------------
// CustomerDirectoryEntry — proyeccion local de `(CustomerId → DisplayName,
// Email, IsActive)` alimentada por customer.created.v1/updated.v1/
// deactivated.v1. A diferencia de UserDirectoryEntry (empleados, via
// auth.user.*), esta cubre customers: el hot-path es el host de un meeting
// buscando/autocompletando un customer por nombre/email al armar invitaciones
// (Fase Backend 5). Decision Fase Backend 10: SI crear esta tabla (a
// diferencia de InvitationTokenLookup/NotificationInbox, descartadas por
// tener ya un indice/tabla que cumple el mismo rol).
// @since Fase Backend 10
model CustomerDirectoryEntry {
  CustomerId   String   @id @db.UniqueIdentifier
  TenantId     String   @db.UniqueIdentifier
  DisplayName  String   @db.NVarChar(200)
  Email        String   @db.NVarChar(320)
  IsActive     Boolean  @default(true)
  // Foto vigente de la ficha del cliente (Customer.ProfilePictureFileId). Null = sin foto o archivado.
  AvatarFileId String?  @db.UniqueIdentifier
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId, IsActive])
  @@index([TenantId, DisplayName])
  // F8c (T-14): rail Clients paginado por nombre.
  @@index([TenantId, IsActive, DisplayName])
}

// -----------------------------------------------------------------------------
// CustomerPreparerAssignment — proyeccion local de "que preparador (UserId de
// Auth) tiene asignado este customer ahora mismo", alimentada por los
// consumers de customer.preparer_assigned.v1 / customer.preparer_unassigned.v1
// (fuente de verdad: Customer.AssignedPreparerUserId). CustomerId es @id
// porque el invariante de negocio es "un customer tiene a lo sumo un
// preparador activo a la vez" (mismo invariante que protege el aggregate
// Customer). Consumida por start-direct-conversation.ts para calcular
// isPrimaryPreparer y por el gate de RestrictCustomerChatToAssignedPreparer.
// @since Fase B2 (chat tipado)
model CustomerPreparerAssignment {
  CustomerId     String   @id @db.UniqueIdentifier
  TenantId       String   @db.UniqueIdentifier
  PreparerUserId String   @db.UniqueIdentifier
  AssignedAtUtc  DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId, PreparerUserId])
}

// -----------------------------------------------------------------------------
// CustomerAssignmentProjection (P2) — proyeccion local del set M:N COMPLETO de
// staff asignado a un customer, alimentada por el snapshot
// `customer.assignments_changed.v1` (event-carried state transfer) y sembrada
// por el reconciliador `internal/customers/assignments/reconciliation`. A
// diferencia de CustomerPreparerAssignment (1:1, solo el primary, para
// isPrimaryPreparer), esta cubre TODOS los asignados: es la fuente del gate
// restrictCustomerChatToAssignedPreparer, que con el modelo M:N debe permitir a
// CUALQUIER staff asignado (no solo al primary) chatear con el customer. El
// primary tambien esta en este set, asi que este check subsume el viejo 1:1.
// Version (UpdatedAtUtc del customer) = idempotencia: solo se reemplaza el set
// con snapshots mas nuevos (descarta reordenados/duplicados).
// @since P2.5 (visibilidad por asignacion)
model CustomerAssignmentProjection {
  Id         String   @id @default(uuid()) @db.UniqueIdentifier
  TenantId   String   @db.UniqueIdentifier
  CustomerId String   @db.UniqueIdentifier
  UserId     String   @db.UniqueIdentifier
  Version    DateTime @db.DateTime2

  @@unique([TenantId, CustomerId, UserId])
  @@index([TenantId, CustomerId])
  // F8c: "mis clientes asignados" (ABAC dentro de la consulta del rail).
  @@index([TenantId, UserId])
}

// -----------------------------------------------------------------------------
// AttachmentTracking — vincula un CloudStorage FileId con el Message de chat
// que lo referencia, y su estado de disponibilidad (Pending/Available/
// Infected/Deleted). Alimentada por `send-message.ts` (crea Pending al enviar
// el mensaje) y los consumers de cloudstorage.file.available/infected/deleted.
//
// Antes de esto, `Message.AttachmentFileId` era un UUID que el cliente pasaba
// sin ninguna validacion server-side: si el archivo nunca completaba el scan
// ClamAV, resultaba infected, o se borraba por retencion, el chat seguia
// mostrandolo como si nada. Con esta tabla, un consumer puede detectar el caso
// infected y notificar a la conversacion via `chat.message.attachment_flagged`.
// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// AttachmentUploadReservation — F11 (seguridad): quién inició la subida de un adjunto y para qué
// conversación. `send-message` solo acepta un fileId con su reserva (mismo tenant, conversación y
// usuario) y la consume en el mismo paso: un archivo no se puede reenviar ni rebindear a otro chat.
// -----------------------------------------------------------------------------
model AttachmentUploadReservation {
  FileId           String   @id @db.UniqueIdentifier
  TenantId         String   @db.UniqueIdentifier
  ConversationId   String   @db.UniqueIdentifier
  UploadedByUserId String   @db.UniqueIdentifier
  CreatedAtUtc     DateTime @default(now()) @db.DateTime2

  @@index([CreatedAtUtc])
}

model AttachmentTracking {
  FileId         String   @id @db.UniqueIdentifier
  MessageId      String   @db.UniqueIdentifier
  ConversationId String   @db.UniqueIdentifier
  TenantId       String   @db.UniqueIdentifier
  Status         String   @default("Pending") @db.NVarChar(16) // Pending | Available | Infected | Deleted | BlockedByPolicy | PendingReview
  // F8d (ADD-01): tipo real (detectado por CloudStorage), categoría y datos para las pestañas de Info.
  Category       String?  @db.NVarChar(16)
  ContentType    String?  @db.NVarChar(128)
  FileName       String?  @db.NVarChar(260)
  SizeBytes      BigInt?
  CreatedAtUtc   DateTime @default(now()) @db.DateTime2
  UpdatedAtUtc   DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([MessageId])
  @@index([TenantId, Status])
  @@index([ConversationId, Category, CreatedAtUtc(sort: Desc)])
}

// -----------------------------------------------------------------------------
// ProcessedEvent — inbox durable para RabbitMQ consumers.
// Idempotencia por EventId; el consumer sólo procesa si no existe.
// -----------------------------------------------------------------------------
model ProcessedEvent {
  EventId        String   @id @db.UniqueIdentifier
  Source         String   @db.NVarChar(64)
  EventType      String   @db.NVarChar(128)
  TenantId       String?  @db.UniqueIdentifier
  ProcessedAtUtc DateTime @default(now()) @db.DateTime2

  @@index([Source, EventType])
}

// -----------------------------------------------------------------------------
// OutboxMessage — outbox durable para publicar integration events.
// El worker lee pendientes y los publica al exchange taxvision-events.
// -----------------------------------------------------------------------------
model OutboxMessage {
  Id             String    @id @default(uuid()) @db.UniqueIdentifier
  EventId        String    @unique @db.UniqueIdentifier
  TenantId       String    @db.UniqueIdentifier
  EventType      String    @db.NVarChar(128)
  Payload        String    @db.NVarChar(Max)
  CorrelationId  String?   @db.NVarChar(64)
  OccurredAtUtc  DateTime  @db.DateTime2
  PublishedAtUtc DateTime? @db.DateTime2
  Attempts       Int       @default(0)
  LastError      String?   @db.NVarChar(Max)
  CreatedAtUtc   DateTime  @default(now()) @db.DateTime2

  @@index([PublishedAtUtc])
  @@index([TenantId])
}

// -----------------------------------------------------------------------------
// IdempotencyRecord — commit del resultado por (TenantId, ClientKey).
// Cierra CRIT-10 del legacy: la idempotencia es explicita y compartida entre
// pods (Redis lookup + DB fallback). El campo Payload guarda el ack devuelto
// para replay bit-a-bit del cliente.
// -----------------------------------------------------------------------------
model IdempotencyRecord {
  TenantId      String   @db.UniqueIdentifier
  UserId        String   @db.UniqueIdentifier
  Scope         String   @db.NVarChar(64)
  ClientKey     String   @db.NVarChar(128)
  ResultPayload String   @db.NVarChar(Max)
  CreatedAtUtc  DateTime @default(now()) @db.DateTime2

  @@id([TenantId, UserId, Scope, ClientKey])
  @@index([CreatedAtUtc])
}

// =============================================================================
// FASE 1 — Chat (Conversation aggregate)
// =============================================================================
// El agregado raiz es Conversation. Direct chat cliente <-> empleado va en
// scope; group chat esta modelado pero apagado por default (settings).
// Reactions / threading / message search se dejan como pendientes explicitos
// (columnas reservadas o endpoints scaffold), NUNCA como TODO silencioso.

// Kinds de conversacion. Los valores son strings para tolerar renames en
// versionado; en dominio se validan como enum union type.
//   Direct         — 1:1 entre dos usuarios del mismo tenant (cliente <-> preparer).
//   Group          — grupo interno por tenant (feature apagada por default).
//   Support        — chat de soporte cross-tenant (PlatformTenant <-> tenant customer).
//   Meeting        — chat 1:1 con un Meeting (Fase 8); participantes sincronizados
//                    con quien esta Joined en el meeting, nunca editados a mano.
model Conversation {
  Id               String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId         String    @db.UniqueIdentifier
  // "Direct" | "Group" | "Support" | "Meeting" — validado en dominio.
  Kind             String    @db.NVarChar(32)
  // Group: nombre del grupo. Meeting: titulo del meeting (informativo). Direct/Support = null.
  Title            String?   @db.NVarChar(120)
  // Direct: `direct:{userA}:{userB}` (ids ordenados) para lookup rapido.
  // Group: `group:{groupId}`. Support: `support:{ticketId}`.
  UniquenessKey    String    @db.NVarChar(256)
  IsArchived       Boolean   @default(false)
  // F8a: dueño derivado de la clave (meeting:{id} / support:{ticketId}) para listar y archivar sin parsear.
  MeetingId        String?   @db.UniqueIdentifier
  SupportTicketId  String?   @db.UniqueIdentifier
  LastMessageAtUtc DateTime? @db.DateTime2
  // F8b (T-21, D-23): datos del grupo y modo anuncio (solo Owner/Admin escriben).
  Description      String?   @db.NVarChar(500)
  AvatarFileId     String?   @db.UniqueIdentifier
  AdminsOnlyWrite  Boolean   @default(false)
  CreatedByUserId  String    @db.UniqueIdentifier
  CreatedAtUtc     DateTime  @default(now()) @db.DateTime2
  UpdatedAtUtc     DateTime  @default(now()) @updatedAt @db.DateTime2

  Participants ConversationParticipant[]
  Messages     Message[]

  @@unique([TenantId, UniquenessKey])
  @@index([TenantId, IsArchived, LastMessageAtUtc(sort: Desc)])
  // F8a: listado separado por tipo (Chat = Direct,Group; Support aparte; Meeting en la ficha).
  @@index([TenantId, Kind, IsArchived, LastMessageAtUtc(sort: Desc)])
  @@index([TenantId, MeetingId])
  @@index([TenantId, SupportTicketId])
}

model ConversationParticipant {
  Id                String    @id @default(uuid()) @db.UniqueIdentifier
  ConversationId    String    @db.UniqueIdentifier
  TenantId          String    @db.UniqueIdentifier
  UserId            String    @db.UniqueIdentifier
  DisplayName       String    @db.NVarChar(120)
  ActorType         String    @db.NVarChar(32)
  // "Owner" | "Admin" | "Member" — Owner es quien creo la conversacion; Admin solo en Group (F8b, D-22).
  // Direct: ambos Members. No confundir con rol Auth.
  Role              String    @default("Member") @db.NVarChar(32)
  // F8b (D-58): cliente detrás de la cuenta de portal; null para staff.
  CustomerId        String?   @db.UniqueIdentifier
  // Cierre del "Only Owner for now" del frontend cliente: marca al preparador
  // principal asignado al customer (Customer.PortalOwner). El FE puede elegir
  // multi-thread cuando exista, sin cambio de schema.
  IsPrimaryPreparer Boolean   @default(false)
  IsMuted           Boolean   @default(false)
  IsRemoved         Boolean   @default(false)
  JoinedAtUtc       DateTime  @default(now()) @db.DateTime2
  RemovedAtUtc      DateTime? @db.DateTime2
  LastReadAtUtc     DateTime? @db.DateTime2
  LastReadMessageId String?   @db.UniqueIdentifier

  Conversation Conversation @relation(fields: [ConversationId], references: [Id], onDelete: Cascade)

  @@unique([ConversationId, UserId])
  @@index([TenantId, UserId, IsRemoved])
  @@index([TenantId, CustomerId])
}

// F8b (T-22): auditoría de administración de grupos (alta, baja, roles, datos, modo anuncio).
// Consultable por Tenant Admin / PlatformAdmin; no se borra con los mensajes.
model ConversationAudit {
  Id             String   @id @default(uuid()) @db.UniqueIdentifier
  TenantId       String   @db.UniqueIdentifier
  ConversationId String   @db.UniqueIdentifier
  // MemberAdded | MemberRemoved | MemberLeft | RoleChanged | OwnershipTransferred | InfoUpdated | AdminsOnlyChanged | Archived
  Action         String   @db.NVarChar(48)
  ActorUserId    String?  @db.UniqueIdentifier
  TargetUserId   String?  @db.UniqueIdentifier
  // JSON corto con el detalle (rol nuevo, nombre anterior, etc.).
  Metadata       String?  @db.NVarChar(2000)
  OccurredAtUtc  DateTime @default(now()) @db.DateTime2

  @@index([TenantId, ConversationId, OccurredAtUtc(sort: Desc)])
}

// Kind del mensaje:
//   Text        — texto plano (max 4000 chars).
//   Attachment  — referencia a un FileId (chat attachment / voice / video / screenshot).
//   System      — mensaje sintetizado (participant added, muted-all, etc).
// Reactions/threading NO se modelan aqui — solucion se documenta cuando llegue
// su fase; nada de TODO en produccion.
model Message {
  Id                     String    @id @default(uuid()) @db.UniqueIdentifier
  ConversationId         String    @db.UniqueIdentifier
  TenantId               String    @db.UniqueIdentifier
  SenderId               String    @db.UniqueIdentifier
  // Denormalizacion controlada: nunca perdemos "quien envio" aunque el usuario
  // se dé de baja en Auth (cierre CRIT-17 del legacy).
  SenderDisplayName      String    @db.NVarChar(120)
  Kind                   String    @db.NVarChar(32)
  // Solo para Kind=Text; capado a 4000 chars a nivel dominio.
  Body                   String?   @db.NVarChar(4000)
  // Solo para Kind=Attachment: FileId en CloudStorage. Metadata (mime, size)
  // llega por FileMetadataRef en fases posteriores.
  AttachmentFileId       String?   @db.UniqueIdentifier
  // Optional reply-to (soporte trivial de citacion — no thread real).
  ReplyToMessageId       String?   @db.UniqueIdentifier
  // Fase Backend 9 — forwarding. Ref al mensaje original en OTRA conversation.
  // No FK: la conversation origen podria estar en otro tenant en el futuro
  // (support cross-tenant), y una FK duro cascadearia deletes cross-tenant.
  ForwardedFromMessageId String?   @db.UniqueIdentifier
  IsEdited               Boolean   @default(false)
  // F8: cuántas veces se editó (tope por política); cada versión anterior queda en MessageEdit.
  EditCount              Int       @default(0)
  IsDeleted              Boolean   @default(false)
  // Fase Backend 9 — pinned messages. Solo host/cohost puede pinear en groups;
  // ambos participantes pueden en Direct/Meeting/Support (autorizacion en el
  // use case, no en el aggregate — depende del ConversationKind).
  IsPinned               Boolean   @default(false)
  PinnedAtUtc            DateTime? @db.DateTime2
  PinnedByUserId         String?   @db.UniqueIdentifier
  DeletedAtUtc           DateTime? @db.DateTime2
  CreatedAtUtc           DateTime  @default(now()) @db.DateTime2
  EditedAtUtc            DateTime? @db.DateTime2
  // Notas de voz (Kind=Attachment con adjunto audio/*): duración en ms y waveform (JSON array de
  // picos 0-100) calculados por el cliente al grabar. Null para cualquier otro mensaje.
  AudioDurationMs        Int?
  AudioWaveform          String?   @db.NVarChar(Max)
  // F7 (D-27): transcript de la nota de voz (texto corto en línea) y su estado.
  TranscriptText         String?   @db.NVarChar(4000)
  TranscriptState        String?   @db.NVarChar(16)
  TranscriptLanguage     String?   @db.NVarChar(16)

  Conversation Conversation      @relation(fields: [ConversationId], references: [Id], onDelete: Cascade)
  Receipts     MessageReceipt[]
  Reactions    MessageReaction[]
  Edits        MessageEdit[]
  Links        MessageLink[]

  @@index([ConversationId, CreatedAtUtc])
  @@index([TenantId, SenderId, CreatedAtUtc])
  // Filtered index para el "list pinned" del conversation topbar — SQL Server
  // permite WHERE clause en indices no-clustered, es mucho mas barato que un
  // full scan filtrando IsPinned=true de una conversation con miles de msgs.
  @@index([ConversationId, PinnedAtUtc(sort: Desc)])
}

// F8 — historial de ediciones: el texto que había antes de cada edición. Lo ven los participantes
// ("Edited" → versiones), nunca en un mensaje borrado. Revision 1 = el texto original.
model MessageEdit {
  Id             String   @id @default(uuid()) @db.UniqueIdentifier
  MessageId      String   @db.UniqueIdentifier
  TenantId       String   @db.UniqueIdentifier
  Revision       Int
  PreviousBody   String   @db.NVarChar(4000)
  EditedByUserId String   @db.UniqueIdentifier
  EditedAtUtc    DateTime @db.DateTime2

  Message Message @relation(fields: [MessageId], references: [Id], onDelete: Cascade)

  @@unique([MessageId, Revision])
  @@index([TenantId, MessageId])
}

// -----------------------------------------------------------------------------
// FASE BACKEND 9 — Reactions
// -----------------------------------------------------------------------------
// Un usuario puede reaccionar N veces al mismo mensaje con emojis distintos,
// pero solo UNA vez con el mismo emoji (@@unique([MessageId, UserId, Emoji]) —
// deduplica double-tap del cliente sin necesitar idempotency-key).
// El emoji se guarda como el codepoint literal (NVarChar corto) — asi el FE
// puede rendearlo directo sin mapeo, y ClickHouse/analytics puede agregarlo
// por popularidad sin depender de un catalogo separado.
model MessageReaction {
  Id           String   @id @default(uuid()) @db.UniqueIdentifier
  MessageId    String   @db.UniqueIdentifier
  TenantId     String   @db.UniqueIdentifier
  UserId       String   @db.UniqueIdentifier
  Emoji        String   @db.NVarChar(16)
  CreatedAtUtc DateTime @default(now()) @db.DateTime2

  Message Message @relation(fields: [MessageId], references: [Id], onDelete: Cascade)

  @@unique([MessageId, UserId, Emoji])
  @@index([TenantId, MessageId])
}

// Receipt por (mensaje, destinatario). "Delivered" = socket lo entrego a un
// receiver online; "Read" = destinatario lo abrio en su chat. Cierre del bug
// legacy de N+1: se batchean en la Application layer y no se upsert por mensaje.
model MessageReceipt {
  MessageId      String    @db.UniqueIdentifier
  UserId         String    @db.UniqueIdentifier
  TenantId       String    @db.UniqueIdentifier
  DeliveredAtUtc DateTime? @db.DateTime2
  ReadAtUtc      DateTime? @db.DateTime2

  Message Message @relation(fields: [MessageId], references: [Id], onDelete: Cascade)

  @@id([MessageId, UserId])
  @@index([TenantId, UserId, ReadAtUtc])
}

// =============================================================================
// FASE 2 — Calls 1:1 (audio/video WebRTC mesh)
// =============================================================================
// Aggregate root: Call. Un unico callee (mesh 1:1). Multi-party llega en Fase 3
// (Meeting). Estados: Ringing -> Accepted -> Active -> Ended, o alternativos
// Rejected/Cancelled/MissedCall/Failed. Duracion se calcula al Ended sobre
// StartedAtUtc <-> EndedAtUtc del participante Callee (aceptacion).

model Call {
  Id                         String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId                   String    @db.UniqueIdentifier
  // "Audio" | "Video"
  Kind                       String    @db.NVarChar(16)
  // "Ringing" | "Accepted" | "Rejected" | "Cancelled" | "MissedCall" | "Active" | "Ended" | "Failed"
  Status                     String    @db.NVarChar(24)
  CallerUserId               String    @db.UniqueIdentifier
  CalleeUserId               String    @db.UniqueIdentifier
  // Referencia opcional a la conversation 1:1 asociada (si vino de un chat).
  ConversationId             String?   @db.UniqueIdentifier
  RingingAtUtc               DateTime  @db.DateTime2
  AcceptedAtUtc              DateTime? @db.DateTime2
  StartedAtUtc               DateTime? @db.DateTime2 // ambos peers reportaron media-status active
  EndedAtUtc                 DateTime? @db.DateTime2
  EndReason                  String?   @db.NVarChar(64) // "Hangup" | "Missed" | "Rejected" | "Cancelled" | "IceFailed"
  DurationSeconds            Int?
  // Recording (opcional; feature flag por tenant).
  RecordingRequested         Boolean   @default(false)
  RecordingFileId            String?   @db.UniqueIdentifier
  // Transcript STT (Fase 6) — lo llena el worker de transcripts via evento
  // communication.call.transcript_ready.v1, nunca escrito por el socket.
  TranscriptFileId           String?   @db.UniqueIdentifier
  // F4 (INV-12 H-3): tope de minutos del plan fijado al aceptar.
  MaxDurationMinutes         Int?
  EndsAtUtc                  DateTime? @db.DateTime2
  LastDurationWarningSeconds Int?
  CreatedAtUtc               DateTime  @default(now()) @db.DateTime2
  UpdatedAtUtc               DateTime  @default(now()) @updatedAt @db.DateTime2

  Participants CallParticipant[]

  @@index([TenantId, Status, RingingAtUtc(sort: Desc)])
  @@index([TenantId, CallerUserId, RingingAtUtc(sort: Desc)])
  @@index([TenantId, CalleeUserId, RingingAtUtc(sort: Desc)])
  @@index([Status, EndsAtUtc])
}

/// F4: minutos de llamada consumidos por oficina y mes (maxMonthlyMinutes del plan).
model TenantCallUsage {
  TenantId     String   @db.UniqueIdentifier
  YearMonth    String   @db.NVarChar(7)
  Seconds      Int      @default(0)
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime2

  @@id([TenantId, YearMonth])
}

model CallParticipant {
  Id                      String    @id @default(uuid()) @db.UniqueIdentifier
  CallId                  String    @db.UniqueIdentifier
  TenantId                String    @db.UniqueIdentifier
  UserId                  String    @db.UniqueIdentifier
  DisplayName             String    @db.NVarChar(120)
  // "Caller" | "Callee"
  Role                    String    @db.NVarChar(16)
  // Server-assigned monotonic; el que tenga JoinOrder mayor es "polite" en la
  // perfect-negotiation regla del plan §9C.
  JoinOrder               Int
  JoinedAtUtc             DateTime  @default(now()) @db.DateTime2
  LeftAtUtc               DateTime? @db.DateTime2
  // Consolidado — sustituye eventos separados participant_muted /
  // participant_video_on|off / participant_screen_share_start|stop del legacy.
  AudioEnabled            Boolean   @default(true)
  VideoEnabled            Boolean   @default(true)
  ScreenSharing           Boolean   @default(false)
  // Fase Backend 7 — timestamp del inicio del share actual (para calcular
  // durationSeconds en CallScreenShareStoppedEvent). Null cuando no se esta
  // compartiendo.
  ScreenShareStartedAtUtc DateTime? @db.DateTime2
  ConnectionQuality       String    @default("Unknown") @db.NVarChar(16)
  // D-58 (F4): cliente detras del usuario del portal.
  CustomerId              String?   @db.UniqueIdentifier

  Call Call @relation(fields: [CallId], references: [Id], onDelete: Cascade)

  @@unique([CallId, UserId])
  @@index([TenantId, UserId, LeftAtUtc])
  @@index([TenantId, CustomerId])
}

// =============================================================================
// FASE 3 — Meetings multi-party (waiting room, roles, host controls, mesh/SFU)
// =============================================================================
// Aggregate root: Meeting. Estados: Scheduled -> Live -> Ended, o Cancelled.
// Waiting room queda como estado del participant. Roles: Host, Cohost, Attendee.
// Passcode se guarda con Argon2 (cierra CRIT-15 legacy). Invitation guarda solo
// SHA-256 del token opaco (cierra CRIT-6, nunca JWT en claro).

model Meeting {
  Id                         String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId                   String    @db.UniqueIdentifier
  Title                      String    @db.NVarChar(200)
  Description                String?   @db.NVarChar(1000)
  Status                     String    @db.NVarChar(24) // "Scheduled"|"Live"|"Ended"|"Cancelled"
  // Codigo humano corto (9 chars alfanumericos) — usado en el link de join.
  ShortCode                  String    @db.NVarChar(16)
  PasscodeHash               String?   @db.NVarChar(255) // Argon2; null = sin passcode
  RequireWaitingRoom         Boolean   @default(true)
  IsLocked                   Boolean   @default(false)
  MaxParticipants            Int       @default(4)
  // "Mesh" | "Sfu" — decidido al Start segun MaxParticipants + tenant setting.
  Strategy                   String    @default("Mesh") @db.NVarChar(16)
  RecordingRequested         Boolean   @default(false)
  RecordingFileId            String?   @db.UniqueIdentifier
  // Transcript STT (Fase 6) — mismo criterio que Call.TranscriptFileId.
  TranscriptFileId           String?   @db.UniqueIdentifier
  // INV-T01 R-7: idioma del transcript de la reunión; null = el de cada participante / la oficina.
  TranscriptLanguage         String?   @db.NVarChar(16)
  HostUserId                 String    @db.UniqueIdentifier
  ScheduledForUtc            DateTime? @db.DateTime2
  StartedAtUtc               DateTime? @db.DateTime2
  EndedAtUtc                 DateTime? @db.DateTime2
  DurationSeconds            Int?
  // Ciclo de vida (INV-11, D-34/D-35): la programada es informativa; el corte es MaxDuration
  // fijado al Start con el resolver. EndReason: Host|MaxDurationReached|NoParticipants|Offboarding|Backfill.
  ScheduledDurationMinutes   Int?
  MaxDurationMinutes         Int?
  EndsAtUtc                  DateTime? @db.DateTime2
  EndReason                  String?   @db.NVarChar(32)
  // Umbral (segundos) del último aviso 10/5/1 ya emitido: el scheduler no lo repite.
  LastDurationWarningSeconds Int?
  // "Start a new meeting" (D-34): enlaza la continuación con la reunión que se cortó.
  ContinuationOfMeetingId    String?   @db.UniqueIdentifier
  // F6 (T-64): recordatorio enviado una sola vez.
  ReminderSentAtUtc          DateTime? @db.DateTime2
  CreatedByUserId            String    @db.UniqueIdentifier
  CreatedAtUtc               DateTime  @default(now()) @db.DateTime2
  UpdatedAtUtc               DateTime  @default(now()) @updatedAt @db.DateTime2

  Participants MeetingParticipant[]
  Invitations  MeetingInvitation[]

  @@unique([TenantId, ShortCode])
  @@index([TenantId, Status, ScheduledForUtc])
  @@index([TenantId, HostUserId])
  @@index([TenantId, Status, EndsAtUtc])
}

model MeetingParticipant {
  Id                String    @id @default(uuid()) @db.UniqueIdentifier
  MeetingId         String    @db.UniqueIdentifier
  TenantId          String    @db.UniqueIdentifier
  UserId            String    @db.UniqueIdentifier
  DisplayName       String    @db.NVarChar(120)
  // Espejo libre del claim JWT actor_type ("TenantEmployee"|"TenantAdmin"|
  // "Customer"|...). Fase Backend 5 agrega "Guest" para invitados sin cuenta
  // Auth que entran via join-by-token + shortLivedJoinTicket.
  ActorType         String    @default("TenantEmployee") @db.NVarChar(32)
  // D-58: cliente detrás de un usuario del portal (null para staff/guests). El historial del cliente
  // sobrevive aunque su cuenta de portal se desactive.
  CustomerId        String?   @db.UniqueIdentifier
  // "Host" | "Cohost" | "Attendee"
  Role              String    @db.NVarChar(16)
  // "Waiting" | "Joined" | "Left" | "Removed"
  Status            String    @db.NVarChar(16)
  JoinOrder         Int
  RequestedAtUtc    DateTime  @default(now()) @db.DateTime2
  AdmittedAtUtc     DateTime? @db.DateTime2
  JoinedAtUtc       DateTime? @db.DateTime2
  LeftAtUtc         DateTime? @db.DateTime2
  // Consolidado (peer_status)
  AudioEnabled      Boolean   @default(true)
  VideoEnabled      Boolean   @default(true)
  ScreenSharing     Boolean   @default(false)
  HandRaised        Boolean   @default(false)
  // F5 (D-49): cola de manos ordenada por este instante; null = mano baja.
  HandRaisedAtUtc   DateTime? @db.DateTime2
  ConnectionQuality String    @default("Unknown") @db.NVarChar(16)

  Meeting Meeting @relation(fields: [MeetingId], references: [Id], onDelete: Cascade)

  @@unique([MeetingId, UserId])
  @@index([TenantId, UserId, Status])
  @@index([MeetingId, Status])
  @@index([TenantId, CustomerId])
}

// -----------------------------------------------------------------------------
// MeetingEventLog — todo lo que pasa dentro de una reunión/llamada, en orden (C.3, INV-13 T-32).
// -----------------------------------------------------------------------------
model MeetingEventLog {
  Id            String   @id @default(uuid()) @db.UniqueIdentifier
  TenantId      String   @db.UniqueIdentifier
  // "Meeting" | "Call"
  Scope         String   @db.NVarChar(16)
  ScopeId       String   @db.UniqueIdentifier
  Seq           Int
  At            DateTime @db.DateTime2
  Type          String   @db.NVarChar(64)
  ActorUserId   String?  @db.UniqueIdentifier
  TargetUserId  String?  @db.UniqueIdentifier
  PayloadJson   String?  @db.NVarChar(Max)
  CorrelationId String?  @db.NVarChar(128)

  @@unique([ScopeId, Seq])
  @@index([TenantId, ScopeId, Seq])
  @@index([TenantId, Type, At])
}

// =============================================================================
// FASE 7 — Analytics diario (event-sourced snapshot)
// =============================================================================
// Un row por (TenantId, Day). Consumers propios incrementan contadores; los
// endpoints leen agregado por rango. Cierre CRIT legacy: sin queries en tablas
// operacionales (Conversation/Message/Call/Meeting) para reportes.

model CommunicationAnalyticsSnapshot {
  TenantId               String   @db.UniqueIdentifier
  Day                    DateTime @db.Date
  MessagesSent           Int      @default(0)
  ConversationsStarted   Int      @default(0)
  CallsStarted           Int      @default(0)
  CallsEnded             Int      @default(0)
  CallMinutes            Int      @default(0)
  MissedCalls            Int      @default(0)
  MeetingsScheduled      Int      @default(0)
  MeetingsStarted        Int      @default(0)
  MeetingsEnded          Int      @default(0)
  MeetingMinutes         Int      @default(0)
  SupportTicketsOpened   Int      @default(0)
  SupportTicketsResolved Int      @default(0)
  // F10 (ADD-08 T-71): contadores de plataforma, todos por eventos; duraciones en segundos (sin truncar).
  AudioCallsStarted             Int      @default(0)
  VideoCallsStarted             Int      @default(0)
  CallsUpgradedToVideo          Int      @default(0)
  CallsCompleted                Int      @default(0)
  CallsFailed                   Int      @default(0)
  CallsRejected                 Int      @default(0)
  CallsCancelled                Int      @default(0)
  CallsEndedByLimit             Int      @default(0)
  CallSeconds                   Int      @default(0)
  MeetingsCancelled             Int      @default(0)
  MeetingsExpired               Int      @default(0)
  MeetingsEndedBySystem         Int      @default(0)
  MeetingsMesh                  Int      @default(0)
  MeetingsSfu                   Int      @default(0)
  MeetingSeconds                Int      @default(0)
  ParticipantsJoined            Int      @default(0)
  GuestsJoined                  Int      @default(0)
  ParticipantSeconds            Int      @default(0)
  Rejoins                       Int      @default(0)
  ParticipantsDroppedAfterGrace Int      @default(0)
  TransportFailures             Int      @default(0)
  QualitySummaries              Int      @default(0)
  QualityExcellentReports       Int      @default(0)
  QualityGoodReports            Int      @default(0)
  QualityFairReports            Int      @default(0)
  QualityPoorReports            Int      @default(0)
  QualityDisconnectedReports    Int      @default(0)
  RelayReports                  Int      @default(0)
  RecordingsStarted             Int      @default(0)
  RecordingsReady               Int      @default(0)
  RecordingsFailed              Int      @default(0)
  RecordingSeconds              Int      @default(0)
  RecordingBytes                BigInt   @default(0)
  TranscriptsReady              Int      @default(0)
  TranscriptsFailed             Int      @default(0)
  TranscriptAudioSeconds        Int      @default(0)
  TranscriptProcessingSeconds   Int      @default(0)
  InvitationsCreated            Int      @default(0)
  InvitationsUsed               Int      @default(0)
  InvitationsExpired            Int      @default(0)
  InvitationsRevoked            Int      @default(0)
  // Máximo observado en el día (no se suma): reuniones en vivo y participantes conectados de la oficina.
  PeakConcurrentMeetings        Int      @default(0)
  PeakConcurrentParticipants    Int      @default(0)
  // Plan de la oficina al registrar el día ("uso por plan" sin llamar a Subscription).
  PlanCode                      String?  @db.NVarChar(64)
  UpdatedAtUtc                  DateTime @default(now()) @updatedAt @db.DateTime2

  @@id([TenantId, Day])
  @@index([Day])
}

// =============================================================================
// FASE 5 — Support cross-tenant (PlatformTenant ↔ tenant customer)
// =============================================================================
// SupportTicket es la unica entidad del microservicio que enlaza DOS tenants:
//   - TenantId          = tenant del customer (dueno del chat, PII scoped aqui)
//   - AgentTenantId     = tenant del agente (siempre PlatformTenant)
//
// Cierre CRIT-18 del legacy: el rol de agente VIENE del claim JWT
// `communication.support.agent`, jamas del handshake.query. La validacion
// se hace en application layer antes de tocar el aggregate.

model SupportTicket {
  Id              String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId        String    @db.UniqueIdentifier
  // PlatformTenant fijo (sembrado). Se persiste para permitir consultas eficientes
  // del agente "todos mis tickets" sin cross-tenant scan.
  AgentTenantId   String    @db.UniqueIdentifier
  // Usuario del tenant customer que abrio el ticket.
  OpenedByUserId  String    @db.UniqueIdentifier
  // Agente asignado (null si aun no reclamado). Vive en AgentTenantId.
  AssignedAgentId String?   @db.UniqueIdentifier
  // ID de la Conversation Kind=Support asociada.
  ConversationId  String    @unique @db.UniqueIdentifier
  Subject         String    @db.NVarChar(200)
  Category        String    @db.NVarChar(32) // "Billing"|"Technical"|"Account"|"Other"
  Priority        String    @db.NVarChar(16) // "Low"|"Normal"|"High"|"Urgent"
  Status          String    @db.NVarChar(24) // "Open"|"Claimed"|"WaitingCustomer"|"WaitingAgent"|"Resolved"|"Closed"
  OpenedAtUtc     DateTime  @default(now()) @db.DateTime2
  ClaimedAtUtc    DateTime? @db.DateTime2
  ResolvedAtUtc   DateTime? @db.DateTime2
  ClosedAtUtc     DateTime? @db.DateTime2
  UpdatedAtUtc    DateTime  @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId, Status, OpenedAtUtc(sort: Desc)])
  @@index([AgentTenantId, Status, OpenedAtUtc(sort: Desc)])
  @@index([AgentTenantId, AssignedAgentId, Status])
}

// =============================================================================
// FASE 4 — Notifications in-app realtime
// =============================================================================
// Cada NotificationEntry es un item en la bandeja in-app del usuario. Se crea
// desde los consumers (Signature/Customer/Auth). Emitidos por Socket.IO al room
// `t:{tenantId}:u:{userId}` y persistidos hasta el mark-read + purge.
//
// SEPARACION explicita del legacy: session.revoked y force.logout NUNCA viven
// en esta tabla — llegan por un evento socket propio (cierre CRIT legacy).

model NotificationEntry {
  Id                  String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId            String    @db.UniqueIdentifier
  UserId              String    @db.UniqueIdentifier
  // "signature.reminder_due" | "signature.completed" | "signature.canceled" |
  // "signature.push_challenge" | "customer.bulk_import_completed" | ...
  Kind                String    @db.NVarChar(64)
  Priority            String    @default("Normal") @db.NVarChar(16) // "Low"|"Normal"|"High"|"Urgent"
  Title               String    @db.NVarChar(200)
  Body                String    @db.NVarChar(1000)
  Category            String?   @db.NVarChar(32)
  ActorUserId         String?   @db.UniqueIdentifier
  ActorDisplayName    String?   @db.NVarChar(160)
  // "System" | "TenantEmployee" | "TenantAdmin" | "CustomerPortal" | "External".
  // Permite al front distinguir "lo hizo el sistema" (expiración automática) de
  // "lo hizo otro usuario" sin consultar directory por el UUID. Nullable para
  // notificaciones legacy pre-contrato.
  ActorType           String?   @db.NVarChar(32)
  ResourceType        String?   @db.NVarChar(64)
  ResourceId          String?   @db.NVarChar(128)
  ResourceContextJson String?   @db.NVarChar(Max)
  TitleKey            String?   @db.NVarChar(160)
  BodyKey             String?   @db.NVarChar(160)
  ParamsJson          String?   @db.NVarChar(Max)
  Action              String?   @db.NVarChar(32)
  GroupKey            String?   @db.NVarChar(256)
  OccurredAtUtc       DateTime? @db.DateTime2
  // JSON con IDs/URLs para deep-link. Nunca PII.
  MetadataJson        String    @db.NVarChar(Max)
  // Trace del evento originador.
  SourceEventId       String    @db.UniqueIdentifier
  SourceEventType     String    @db.NVarChar(128)
  CorrelationId       String?   @db.NVarChar(64)
  ReadAtUtc           DateTime? @db.DateTime2
  DismissedAtUtc      DateTime? @db.DateTime2
  CreatedAtUtc        DateTime  @default(now()) @db.DateTime2

  @@unique([TenantId, SourceEventId, UserId])
  @@index([TenantId, UserId, ReadAtUtc, CreatedAtUtc(sort: Desc)])
  @@index([TenantId, UserId, GroupKey, ReadAtUtc])
}

// Invitacion firmada por email/link. Guardamos SOLO SHA-256 del token opaco
// generado por el server (32 bytes cripto-random). El token en claro NUNCA
// vuelve a la BD ni al log — se emite en la respuesta de creacion una sola vez.
model MeetingInvitation {
  Id                   String    @id @default(uuid()) @db.UniqueIdentifier
  MeetingId            String    @db.UniqueIdentifier
  TenantId             String    @db.UniqueIdentifier
  // "Employee" | "Customer" | "External" — determina como se resuelve el join:
  // Employee/Customer llevan cuenta Auth real (invitationToken solo destraba
  // el lock del meeting); External nunca tiene cuenta y entra 100% via
  // join-by-token + shortLivedJoinTicket como Guest (Fase Backend 5).
  InviteeKind          String    @default("External") @db.NVarChar(16)
  // Cuando invitamos por email externo (no user Auth) guardamos el email.
  InviteeEmail         String?   @db.NVarChar(320)
  InviteeUserId        String?   @db.UniqueIdentifier
  // Nombre para mostrar cuando no hay cuenta Auth que lo resuelva (Guest).
  InviteeName          String?   @db.NVarChar(120)
  InviteeExternalPhone String?   @db.NVarChar(32)
  TokenHash            String    @db.NVarChar(128)
  ExpiresAtUtc         DateTime  @db.DateTime2
  UsedAtUtc            DateTime? @db.DateTime2
  RevokedAtUtc         DateTime? @db.DateTime2
  // F6 (D-48): usuarios con cuenta reutilizan el token (auditoria de usos); ClosedAtUtc = la reunion
  // termino/se cancelo/expiro con la invitacion abierta.
  FirstUsedAtUtc       DateTime? @db.DateTime2
  LastUsedAtUtc        DateTime? @db.DateTime2
  UseCount             Int       @default(0)
  ClosedAtUtc          DateTime? @db.DateTime2
  CreatedAtUtc         DateTime  @default(now()) @db.DateTime2

  Meeting Meeting @relation(fields: [MeetingId], references: [Id], onDelete: Cascade)

  @@unique([TokenHash])
  @@index([MeetingId, ExpiresAtUtc])
}

// =============================================================================
// FASE BACKEND 2 — Recording consent + state machine
// =============================================================================
// Tablas genericas compartidas entre Meeting y Call (discriminadas por
// Scope+ScopeId) — NO son child-tables de Meeting/MeetingParticipant ni de
// Call/CallParticipant, por eso no llevan @relation ni onDelete Cascade: el
// dominio (RecordingSession/RecordingConsentEntry, ver src/domain/recording/)
// las orquesta desde Meeting.requestRecording/Call.requestRecording pero las
// persiste via su propio repository.

// Log append-only — nunca se actualiza ni se borra una fila existente. Cada
// cambio de respuesta de un usuario agrega una fila nueva, permitiendo
// reconstruir el historial completo (auditoria/compliance de grabaciones).
model RecordingConsentEvent {
  Id             String   @id @default(uuid()) @db.UniqueIdentifier
  TenantId       String   @db.UniqueIdentifier
  Scope          String   @db.NVarChar(16) // "Meeting" | "Call"
  ScopeId        String   @db.UniqueIdentifier // meetingId | callId
  UserId         String   @db.UniqueIdentifier
  Response       String   @db.NVarChar(16) // "Requested" | "Accepted" | "Rejected"
  RespondedAtUtc DateTime @db.DateTime2
  RecordedAtUtc  DateTime @default(now()) @db.DateTime2

  @@index([TenantId, Scope, ScopeId, RespondedAtUtc])
}

// Una unica fila por (Scope, ScopeId) durante toda la vida del meeting/call —
// no hay "reintentar grabar" dentro de la misma sesion; Failed es terminal.
model RecordingSession {
  Id                 String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId           String    @db.UniqueIdentifier
  Scope              String    @db.NVarChar(16) // "Meeting" | "Call"
  ScopeId            String    @db.UniqueIdentifier
  // "Idle"|"Requesting"|"Recording"|"Stopping"|"Processing"|"Ready"|"Failed"
  // ("Idle" nunca se persiste — la ausencia de fila ES Idle.)
  State              String    @db.NVarChar(16)
  RequestedByUserId  String    @db.UniqueIdentifier
  RequestedAtUtc     DateTime  @db.DateTime2
  StartedAtUtc       DateTime? @db.DateTime2
  StoppedAtUtc       DateTime? @db.DateTime2
  RecordingFileId    String?   @db.UniqueIdentifier
  DurationSeconds    Int?
  FailureReason      String?   @db.NVarChar(500)
  // F7: captura en el servidor o mezcla en el cliente (fallback C-03), límite y motivo de corte.
  CaptureMode        String    @default("Client") @db.NVarChar(16)
  MaxDurationSeconds Int?
  LimitWarnedAtUtc   DateTime? @db.DateTime2
  StopReason         String?   @db.NVarChar(32)
  // F7 (T-33): compuesto del recorder y manifest de pistas (JSON) para transcript/recomponer.
  ComposedFileId     String?   @db.UniqueIdentifier
  ComposedSizeBytes  BigInt?
  ComposedFormat     String?   @db.NVarChar(8)
  TracksManifestJson String?   @db.NVarChar(Max)
  ComposedAtUtc      DateTime? @db.DateTime2
  ReadyAtUtc         DateTime? @db.DateTime2
  // F7 (T-37): retención de pistas de audio y del compuesto.
  TracksPurgedAtUtc  DateTime? @db.DateTime2
  PurgedAtUtc        DateTime? @db.DateTime2

  @@unique([Scope, ScopeId])
  @@index([TenantId, Scope, ScopeId])
  @@index([State, CaptureMode])
  @@index([ComposedFileId])
}

/// F7 (T-34): estado del transcript separado del de la grabación (meeting, call o nota de voz).
model TranscriptArtifact {
  Id                 String    @id @default(uuid()) @db.UniqueIdentifier
  TenantId           String    @db.UniqueIdentifier
  Scope              String    @db.NVarChar(16) // "Meeting" | "Call" | "VoiceNote"
  ScopeId            String    @db.UniqueIdentifier
  RecordingSessionId String?   @db.UniqueIdentifier
  State              String    @db.NVarChar(16) // "Processing" | "Ready" | "Failed"
  TxtFileId          String?   @db.UniqueIdentifier
  JsonFileId         String?   @db.UniqueIdentifier
  Language           String?   @db.NVarChar(16)
  Model              String?   @db.NVarChar(64)
  Vad                Boolean   @default(false)
  DurationSeconds    Int?
  WordCount          Int?
  SegmentCount       Int?
  SpeakerCount       Int?
  RealtimeFactor     Float?
  FailureReason      String?   @db.NVarChar(64)
  CreatedAtUtc       DateTime  @default(now()) @db.DateTime2
  CompletedAtUtc     DateTime? @db.DateTime2

  @@unique([Scope, ScopeId])
  @@index([TenantId, Scope, ScopeId])
}

// -----------------------------------------------------------------------------
// CustomerPortalAccount — proyeccion local de (CustomerId -> UserId de portal
// activo). Fase 6 del plan de notificaciones dinamicas: un Signer de Signature
// puede tener MappedCustomerId (cliente registrado), pero eso NO garantiza que
// ese Customer tenga cuenta de portal — investigacion confirmo que
// Auth.User.CustomerId es opcional, sin unicidad garantizada (indice NO
// @@unique), y se crea via un flujo de invitacion desacoplado que puede tardar
// anos o nunca aceptarse. Esta tabla resuelve la pregunta real ("este
// CustomerId tiene HOY un usuario de portal activo") sin llamar a Auth.
// Alimentada por auth.user.registered.v1 (ActorType=CustomerPortal) y
// auth.user.deactivated.v1.
// @since Fase 6 (notificaciones dinamicas)
model CustomerPortalAccount {
  CustomerId   String   @id @db.UniqueIdentifier
  TenantId     String   @db.UniqueIdentifier
  UserId       String   @db.UniqueIdentifier
  IsActive     Boolean  @default(true)
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime2

  @@index([TenantId, IsActive])
  // auth.user.deactivated.v1 solo trae UserId, no CustomerId.
  @@index([UserId])
}

// F8d (T-16): enlaces de los mensajes de texto para la pestaña "Links" de Info. Se reescriben al editar y se
// ocultan con el mensaje borrado (JOIN con IsDeleted = 0).
model MessageLink {
  Id             String   @id @default(uuid()) @db.UniqueIdentifier
  TenantId       String   @db.UniqueIdentifier
  ConversationId String   @db.UniqueIdentifier
  MessageId      String   @db.UniqueIdentifier
  Url            String   @db.NVarChar(2048)
  Domain         String   @db.NVarChar(255)
  CreatedAtUtc   DateTime @db.DateTime2

  Message Message @relation(fields: [MessageId], references: [Id], onDelete: Cascade)

  @@index([ConversationId, CreatedAtUtc(sort: Desc)])
  @@index([MessageId])
}
