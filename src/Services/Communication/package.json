{
  "name": "@taxvision/communication",
  "version": "0.1.0",
  "private": true,
  "description": "TaxVision Communication microservice — chat, calls, meetings, realtime notifs (Node.js + TypeScript + Socket.IO + Prisma + DDD).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "job:expire-stale-meetings": "tsx src/jobs/expire-stale-meetings.ts",
    "job:backfill-participant-customer-id": "tsx src/jobs/backfill-participant-customer-id.ts",
    "job:backfill-chat-content": "tsx src/jobs/backfill-chat-content.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/sensible": "6.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.27.0",
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "8.3.0",
    "amqplib": "0.10.4",
    "argon2": "0.41.1",
    "dotenv": "16.4.5",
    "fastify": "5.12.7",
    "ioredis": "5.4.1",
    "jose": "5.9.6",
    "mediasoup": "^3.21.0",
    "nanoid": "^5.1.16",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prom-client": "15.1.3",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.6",
    "@types/node": "22.12.0",
    "@typescript-eslint/eslint-plugin": "8.17.0",
    "@typescript-eslint/parser": "8.17.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "tsx": "4.23.0",
    "typescript": "5.6.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "argon2": true,
    "esbuild": true,
    "mediasoup": true,
    "prisma": true,
    "protobufjs": true
  },
  "overrides": {
    "minimatch": "11.0.3",
    "glob": "14.0.3"
  }
}
