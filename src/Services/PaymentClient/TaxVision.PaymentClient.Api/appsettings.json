{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services",
    "ValidAudiences": [
      "TaxVision.Services",
      "taxvision-payments"
    ]
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "Encryption": {
    "MasterKey": ""
  },
  "Stripe": {
    "PlatformSecretKey": "",
    "ConnectWebhookSecret": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "AllowedHosts": "*"
}
