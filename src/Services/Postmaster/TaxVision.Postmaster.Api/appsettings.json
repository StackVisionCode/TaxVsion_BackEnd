{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Encryption": {
    "MasterKey": ""
  },
  "DeliveryFeedback": {
    "EngagementEnabled": true,
    "EngagementLookbackHours": 48,
    "MaxEngagementEventsPerRun": 2000
  },
  "SystemEmailProvider": {
    "Host": ""
  },
  "Postmaster": {
    "ServiceAuth": {
      "AuthBaseUrl": "http://localhost:5124",
      "ClientId": "",
      "ClientSecret": ""
    },
    "CloudStorage": {
      "BaseUrl": "http://localhost:5210"
    },
    "Connectors": {
      "BaseUrl": "http://localhost:5390"
    }
  }
}
