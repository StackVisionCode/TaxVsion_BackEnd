{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "Seats": {
    "SlotGating": {
      "Mode": "Enforce",
      "EmitNotifications": true
    }
  },
  "Portal": {
    "BaseUrl": "http://localhost:4200"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "no-reply@taxvision.local",
    "FromName": "TaxVision"
  },
  "Encryption": {
    "MasterKey": ""
  },
  "CloudStorageClient": {
    "BaseUrl": "http://localhost:5330"
  },
  "Notification": {
    "UseFcmPush": true,
    "Retention": {
      "Enabled": true,
      "RetentionMonths": 12,
      "BatchSize": 500,
      "IntervalHours": 24,
      "LockMinutes": 30
    },
    "Push": {
      "Fcm": {
        "ServiceAccountJsonPath": ""
      }
    },
    "Minio": {
      "Endpoint": "localhost:9000",
      "AccessKey": "",
      "SecretKey": "",
      "UseTls": false,
      "TempBucket": "taxvision-temp",
      "SourcePrefix": "notification"
    },
    "Customer": {
      "BaseUrl": "http://localhost:5263",
      "ReconciliationEnabled": true,
      "ReconciliationIntervalHours": 6,
      "ReconciliationPageSize": 200
    },
    "RecipientProjections": {
      "AuthBaseUrl": "http://localhost:5124",
      "ReconciliationEnabled": true,
      "ReconciliationIntervalHours": 12,
      "ReconciliationPageSize": 200
    }
  },
  "ServiceAuthClient": {
    "AuthBaseUrl": "http://localhost:5124",
    "ClientId": "",
    "ClientSecret": ""
  },
  "CustomerVisibility": {
    "Reconciliation": {
      "CustomerBaseUrl": "http://localhost:5263",
      "ReconciliationEnabled": true,
      "ReconciliationIntervalHours": 12,
      "ReconciliationPageSize": 200
    }
  },
  "EmailWebhook": {
    "Secret": ""
  },
  "EmailOAuth": {
    "Gmail": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": "",
      "TenantId": "common"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHosts": "*"
}
