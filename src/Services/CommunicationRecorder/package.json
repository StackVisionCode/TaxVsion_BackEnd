{
  "name": "@taxvision/communication-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "Grabación server-side de Communication: captura RTP por pista con ffmpeg -c copy, composición offline, subida a CloudStorage y eventos.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "amqplib": "0.10.4",
    "dotenv": "16.4.5",
    "fastify": "5.12.7",
    "ioredis": "5.4.1",
    "jose": "5.9.6",
    "minio": "8.0.7",
    "pino": "9.5.0",
    "prom-client": "15.1.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.6",
    "@types/node": "22.12.0",
    "@typescript-eslint/eslint-plugin": "8.17.0",
    "@typescript-eslint/parser": "8.17.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "rimraf": "6.0.1",
    "tsx": "4.23.0",
    "typescript": "5.6.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
