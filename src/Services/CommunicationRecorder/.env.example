# communication-recorder — ejemplo sin secretos. Copiar a .env y completar.
NODE_ENV=development
LOG_LEVEL=info

# API de control (HTTP). En contenedor 5360; en la flota local 5360 lo usa Subscription.
RECORDER_PORT=5360

# Mensajería: eventos al fanout y SaveFileRequested a la cola dedicada de CloudStorage.
RECORDER_RABBITMQ_URI=amqp://user:password@localhost:5672
RECORDER_RABBITMQ_EXCHANGE=taxvision-events
RECORDER_CLOUDSTORAGE_EXTERNAL_QUEUE=cloudstorage-external-uploads

# Cola de composición (lista + lista en curso).
RECORDER_REDIS_URI=redis://localhost:6379

# Cuenta MinIO propia con política acotada a {bucket}/{prefix}/*.
RECORDER_MINIO_ENDPOINT=localhost
RECORDER_MINIO_PORT=9000
RECORDER_MINIO_USE_SSL=false
RECORDER_MINIO_ACCESS_KEY=
RECORDER_MINIO_SECRET_KEY=
RECORDER_MINIO_TEMP_BUCKET=taxvision-temp
RECORDER_MINIO_SOURCE_PREFIX=recording

# JWT de servicio emitido por Auth.
RECORDER_AUTH_JWKS_URI=http://localhost:5124/auth/.well-known/jwks.json
RECORDER_AUTH_ISSUER=TaxVision.Auth
RECORDER_AUTH_AUDIENCE=TaxVision.Services
RECORDER_ALLOWED_CLIENT_IDS=communication-worker

# RTP: IP donde ffmpeg escucha; la anunciada vacía = Communication resuelve el host del recorder.
RECORDER_RTP_LISTEN_IP=127.0.0.1
RECORDER_RTP_ANNOUNCED_IP=
RECORDER_RTP_PORT_MIN=44000
RECORDER_RTP_PORT_MAX=44999

# Spool de pistas + manifest, binarios y fuente para drawtext.
RECORDER_SPOOL_DIR=/var/spool/communication-recorder
RECORDER_FFMPEG_BIN_PATH=ffmpeg
RECORDER_FFPROBE_BIN_PATH=ffprobe
RECORDER_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Fotos de perfil del slate: GET {base}/storage/avatars/{fileId}. Vacío = iniciales.
RECORDER_CLOUDSTORAGE_BASE_URL=
RECORDER_AVATAR_TIMEOUT_MS=3000
RECORDER_AVATAR_MAX_BYTES=2097152

# Capacidad y composición.
RECORDER_MAX_ACTIVE_SESSIONS=4
RECORDER_COMPOSE_THREADS=2
RECORDER_COMPOSE_NICE=10
RECORDER_ORPHAN_TIMEOUT_MINUTES=30
