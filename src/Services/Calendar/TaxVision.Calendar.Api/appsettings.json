{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "TaxVision.Auth",
    "Audience": "TaxVision.Services"
  },
  "Authorization": {
    "PermissionsSource": "Projection"
  },
  "RateLimit": {
    "EnforceTierQuotas": true
  },
  "ServiceAuthClient": {
    "AuthBaseUrl": "http://localhost:5124",
    "ClientId": "",
    "ClientSecret": ""
  },
  "SubscriptionClient": {
    "BaseUrl": "http://localhost:5360"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Calendar": {
    "AttendeeResponseConflictRetry": {
      "MaxAttempts": 3
    },
    "PublicBooking": {
      "HoldMinutes": 10,
      "MaxRequestsPerEmailPerHour": 3,
      "MaxSlotRangeDays": 14,
      "Turnstile": {
        "SiteKey": "",
        "SecretKey": "",
        "SiteVerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
        "ExpectedAction": "public_booking",
        "AllowTestingKeys": false
      }
    },
    "Customer": {
      "BaseUrl": "http://localhost:5263"
    },
    "CustomerDirectoryReconciliation": {
      "IntervalMinutes": 60,
      "PageSize": 200
    }
  }
}
